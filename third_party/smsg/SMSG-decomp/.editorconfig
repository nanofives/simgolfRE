root = true

[*.{txt,editorconfig}]
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,cpp,h,inl}]
indent_style = space
indent_size = 4
charset = latin1
insert_final_newline = true
trim_trailing_whitespace = true

[{*.dsp,*.dsw,*.rc,*.bat,resource.h}]
end_of_line = crlf
