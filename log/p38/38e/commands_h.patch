 // A Blocking pump found no input left: neither an InputSource nor a remaining command (C ABI: SG_E_NO_RESOURCE). `what`
 // is the hooks.csv name of the waiting function.
@@ -162,12 +173,37 @@
     y = cy_;
     return has_cursor_;
   }
+  // a scripted clock (tests): the values of one site, returned in order by clock(site); none left = false
+  void set_clock(int32_t site, std::vector<uint32_t> values) {
+    for (auto &s : clock_)
+      if (s.site == site) {
+        s.values = std::move(values);
+        s.next = 0;
+        return;
+      }
+    clock_.push_back({site, std::move(values), 0});
+  }
+  bool clock(int32_t site, uint32_t &t) override {
+    for (auto &s : clock_)
+      if (s.site == site) {
+        if (s.next >= s.values.size()) return false;
+        t = s.values[s.next++];
+        return true;
+      }
+    return false;
+  }
 
  private:
+  struct SiteClock {
+    int32_t site;
+    std::vector<uint32_t> values;
+    size_t next;
+  };
