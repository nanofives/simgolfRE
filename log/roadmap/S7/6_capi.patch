+int sg_live_stats_ext(sg_ctx *ctx, int64_t out[2]) {
+  if (!ctx || !out) return SG_E_ARG;
+  out[0] = static_cast<int64_t>(ctx->live_res.idle_declines);
+  out[1] = static_cast<int64_t>(ctx->live_res.inflated);
+  return SG_OK;
