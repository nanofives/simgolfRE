+def _growth(mem: list[list[int]]) -> int:
+    """private bytes at the end minus at the first sample from frame 2,000 on (the world is loaded by then)"""
+    after = [m for m in mem if m[0] >= 2000]
+    return after[-1][3] - after[0][3]
