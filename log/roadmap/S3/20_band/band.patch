+M4 rot_m(double a, double x, double y, double z) {
+  const double n = std::sqrt(x * x + y * y + z * z);
+  M4 r = M4::id();
+  if (n == 0.0) return r;
+  x /= n; y /= n; z /= n;
+  const double rad = a * 3.14159265358979323846 / 180.0, c = std::cos(rad), s = std::sin(rad), t = 1.0 - c;
+  r.m[0] = x * x * t + c;     r.m[4] = x * y * t - z * s; r.m[8] = x * z * t + y * s;
+  r.m[1] = y * x * t + z * s; r.m[5] = y * y * t + c;     r.m[9] = y * z * t - x * s;
+  r.m[2] = x * z * t - y * s; r.m[6] = y * z * t + x * s; r.m[10] = z * z * t + c;
+  return r;
+}
+
+enum OpKind : uint8_t { opLI, opPush, opPop, opRotD, opRotF, opTrF, opBind, opBegin, opEnd, opTc2fv, opTc2f, opArr, opNrm, opVtxV, opVtx3f, opEn, opDis,
+                        opBlend, opFlush, opFunc };
+struct Op {
+  OpKind k;
+  uint32_t u0 = 0, u1 = 0;
+  float f[4] = {0, 0, 0, 0};
+  double d[4] = {0, 0, 0, 0};
+};
+struct Block {
+  double ylo = 1e300, yhi = -1e300;
+  float n_in[3] = {0, 0, 1}, tc_in[2] = {0, 0};
+};
+
+}  // namespace
+
+struct WglBands::Impl {
+  int w = 0, h = 0, n = 0, variant = 0;
+  std::string why;
+  struct Worker {
+    std::thread th;
+    std::mutex m;
+    std::condition_variable cv, done;
+    std::deque<std::function<void(WglSink &)>> q;
+    size_t pending = 0;
+    bool stop = false, started = false, ok = false, ctx = false;
+    std::string why;
+  };
+  std::vector<std::unique_ptr<Worker>> ws;
+  // tracking on the calling thread
+  uint32_t mode = 0x1700;
+  std::vector<M4> proj{M4::id()}, mv{M4::id()};
+  int32_t vx = 0, vy = 0, vw = 0, vh = 0;
+  const float *verts = nullptr, *norms = nullptr;
+  int32_t vsize = 3, vstride = 0, nstride = 0;
+  uint32_t vtype = 0x1406, ntype = 0x1406;
+  float cur_n[3] = {0, 0, 1}, cur_tc[2] = {0, 0};
+  std::set<uint32_t> used;
+  // the recorded pass
+  bool rec = false, cull = true;
+  std::vector<Op> ops;
+  std::vector<Block> blocks;
+  std::vector<std::function<void(WglSink &)>> funcs;
+  std::vector<uint16_t> root;
+
+  void worker_main(Worker *wk) {
+    WglSink sink(w, h, variant);
+    {
+      std::lock_guard<std::mutex> l(wk->m);
+      wk->ok = sink.ok();
+      wk->why = sink.why();
+      wk->started = true;
+    }
+    wk->done.notify_all();
+    for (;;) {
+      std::function<void(WglSink &)> job;
+      {
+        std::unique_lock<std::mutex> l(wk->m);
+        wk->cv.wait(l, [&] { return wk->stop || !wk->q.empty(); });
+        if (wk->q.empty()) break;
+        job = std::move(wk->q.front());
+        wk->q.pop_front();
+      }
+      job(sink);
+      {
+        std::lock_guard<std::mutex> l(wk->m);
+        wk->ctx = sink.has_context();
+        --wk->pending;
+      }
+      wk->done.notify_all();
+    }
+  }
+  void post(Worker &wk, std::function<void(WglSink &)> f) {
+    {
+      std::lock_guard<std::mutex> l(wk.m);
+      wk.q.push_back(std::move(f));
+      ++wk.pending;
+    }
+    wk.cv.notify_one();
+  }
+  void broadcast(const std::function<void(WglSink &)> &f) {
+    if (rec) {   // a call that is not a draw call during a pass: kept in order with the recorded ops
+      Op o;
+      o.k = opFunc;
+      o.u0 = static_cast<uint32_t>(funcs.size());
+      funcs.push_back(f);
+      ops.push_back(o);
+      return;
+    }
+    for (auto &wk : ws) post(*wk, f);
+  }
+  void wait_all() {
+    for (auto &wk : ws) {
+      std::unique_lock<std::mutex> l(wk->m);
+      wk->done.wait(l, [&] { return wk->pending == 0; });
+    }
+  }
+  M4 &top() { return mode == 0x1701 ? proj.back() : mv.back(); }
+  void track_vertex(const float *p) {
+    if (blocks.empty()) return;
+    const M4 f = proj.back().mul(mv.back());
+    const double x = p[0], y = p[1], z = p[2];
+    const double cy = f.m[1] * x + f.m[5] * y + f.m[9] * z + f.m[13], cw = f.m[3] * x + f.m[7] * y + f.m[11] * z + f.m[15];
+    if (cw == 0.0) {
+      cull = false;
+      return;
+    }
+    const double wy = (cy / cw + 1.0) * vh / 2.0 + vy;
+    Block &b = blocks.back();
+    if (wy < b.ylo) b.ylo = wy;
+    if (wy > b.yhi) b.yhi = wy;
+  }
+  void rec_op(const Op &o) { ops.push_back(o); }
+
+  // one band's replay of the recorded pass (on its worker)
+  int64_t replay(WglSink &s, int y0, int y1) {
+    int64_t drawn = 0;
+    bool skip = false;
+    for (const Op &o : ops) {
+      if (skip) {
+        if (o.k == opEnd) skip = false;
+        continue;
+      }
+      switch (o.k) {
+        case opLI: s.load_identity(); break;
+        case opPush: s.push_matrix(); break;
+        case opPop: s.pop_matrix(); break;
+        case opRotD: s.rotated(o.d[0], o.d[1], o.d[2], o.d[3]); break;
+        case opRotF: s.rotatef(o.f[0], o.f[1], o.f[2], o.f[3]); break;
+        case opTrF: s.translatef(o.f[0], o.f[1], o.f[2]); break;
+        case opBind: s.bind_texture(o.u0, o.u1); break;
+        case opBegin: {
+          const Block &b = blocks[o.u1];
+          if (cull && (b.yhi < y0 - kMargin || b.ylo > y1 + kMargin)) {
+            skip = true;
+            break;
+          }
+          s.normal3fv(b.n_in);   // the current normal and texture coordinate the block started with in the whole pass
+          s.tex_coord2fv(b.tc_in);
+          s.begin(o.u0);
+          ++drawn;
+          break;
+        }
+        case opEnd: s.end(); break;
+        case opTc2fv: s.tex_coord2fv(o.f); break;
+        case opTc2f: s.tex_coord2f(o.f[0], o.f[1]); break;
+        case opArr: s.array_element(static_cast<int32_t>(o.u0)); break;
+        case opNrm: s.normal3fv(o.f); break;
+        case opVtxV: s.vertex3fv(o.f); break;
+        case opVtx3f: s.vertex3f(o.f[0], o.f[1], o.f[2]); break;
+        case opEn: s.enable(o.u0); break;
+        case opDis: s.disable(o.u0); break;
+        case opBlend: s.blend_func(o.u0, o.u1); break;
+        case opFlush: s.flush(); break;
+        case opFunc: funcs[o.u0](s); break;
+      }
+    }
+    return drawn;
+  }
+};
+
+WglBands::WglBands(int width, int height, int bands, int variant) : p_(std::make_unique<Impl>()) {
+  Impl &p = *p_;
+  p.w = width;
+  p.h = height;
+  p.n = bands < 1 ? 1 : bands;
+  p.variant = variant;
+  p.vw = width;
+  p.vh = height;
+  for (int k = 0; k < p.n; ++k) {
+    p.ws.push_back(std::make_unique<Impl::Worker>());
+    Impl::Worker *wk = p.ws.back().get();
+    wk->th = std::thread([&p, wk] { p.worker_main(wk); });
+  }
+  for (auto &wk : p.ws) {
+    std::unique_lock<std::mutex> l(wk->m);
+    wk->done.wait(l, [&] { return wk->started; });
+    if (!wk->ok && p.why.empty()) p.why = wk->why;
+  }
+}
+
+WglBands::~WglBands() {
+  for (auto &wk : p_->ws) {
+    {
+      std::lock_guard<std::mutex> l(wk->m);
+      wk->stop = true;
+    }
+    wk->cv.notify_one();
+  }
+  for (auto &wk : p_->ws) wk->th.join();
+}
+
+bool WglBands::ok() const { return p_->why.empty(); }
+const std::string &WglBands::why() const { return p_->why; }
+bool WglBands::has_context() const {
+  p_->wait_all();
+  for (auto &wk : p_->ws)
+    if (!wk->ctx) return false;
+  return true;
+}
+
+void WglBands::set_pixels(const std::vector<uint16_t> &px) {
+  Impl &p = *p_;
+  p.wait_all();
+  p.root = px;
+  p.rec = true;
+  p.cull = p.verts != nullptr && p.vsize == 3 && (p.vstride == 0 || p.vstride == 12) && p.vtype == 0x1406;
+  p.ops.clear();
+  p.blocks.clear();
+  p.funcs.clear();
+}
+
+void WglBands::get_pixels(std::vector<uint16_t> &px) {
+  Impl &p = *p_;
+  if (!p.rec) {
+    p.wait_all();
+    return;
+  }
+  p.rec = false;
+  blocks_recorded += static_cast<int64_t>(p.blocks.size());
+  std::atomic<int64_t> drawn{0};
+  if (px.size() != static_cast<size_t>(p.w) * static_cast<size_t>(p.h)) px.assign(static_cast<size_t>(p.w) * static_cast<size_t>(p.h), 0);
+  const float *v = p.verts, *nm = p.norms;
+  // the rows any block reaches: a band no block reaches draws nothing, so its rows keep the root surface's values (px holds them)
+  double ylo = 1e300, yhi = -1e300;
+  for (const Block &bl : p.blocks)
+    if (bl.ylo <= bl.yhi) {
+      ylo = std::min(ylo, bl.ylo);
+      yhi = std::max(yhi, bl.yhi);
+    }
+  const bool has_func = !p.funcs.empty();
+  if (px.data() != p.root.data()) px = p.root;
+  for (int k = 0; k < p.n; ++k) {
+    const int y0 = p.h * k / p.n, y1 = p.h * (k + 1) / p.n;
+    if (p.cull && !has_func && (yhi < y0 - kMargin || ylo > y1 + kMargin)) continue;
+    p.post(*p.ws[static_cast<size_t>(k)], [&p, &px, &drawn, v, nm, y0, y1](WglSink &s) {
+      s.set_rows(p.root, y0, y1);   // the scissor limits the band's drawing and blending reads to its rows
+      s.set_arrays(v, nm);
+      s.scissor_band(y0, y1);
+      drawn += p.replay(s, y0, y1);
+      s.get_rows(px, y0, y1);
+    });
+  }
+  p.wait_all();
+  blocks_drawn += drawn.load();
+}
+
+void WglBands::set_arrays(const float *vertices, const float *normals) {
+  Impl &p = *p_;
+  p.verts = vertices;
+  p.norms = normals;
+  if (!p.rec) p.broadcast([vertices, normals](WglSink &s) { s.set_arrays(vertices, normals); });
+}
+
+bool WglBands::gen_textures_mapped(int32_t n, const uint32_t *names) {
+  std::vector<uint32_t> nm(names, names + (n > 0 ? n : 0));
+  p_->broadcast([nm](WglSink &s) { s.gen_textures_mapped(static_cast<int32_t>(nm.size()), nm.data()); });
+  return true;
+}
+
+// the calls: tracked on this thread; recorded during a pass, else sent to every worker
+#define BAND_REC(op_expr, ...)  \
+  do {                            \
+    if (p_->rec) {                \
+      Op o;                       \
+      op_expr;                    \
+      p_->rec_op(o);              \
+    } else {                      \
+      p_->broadcast(__VA_ARGS__); \
+    }                             \
+  } while (0)
+
+void WglBands::load_identity() {
+  p_->top() = M4::id();
+  BAND_REC(o.k = opLI, [](WglSink &s) { s.load_identity(); });
+}
+void WglBands::push_matrix() {
+  auto &st = p_->mode == 0x1701 ? p_->proj : p_->mv;
+  st.push_back(st.back());
+  BAND_REC(o.k = opPush, [](WglSink &s) { s.push_matrix(); });
+}
+void WglBands::pop_matrix() {
+  auto &st = p_->mode == 0x1701 ? p_->proj : p_->mv;
+  if (st.size() > 1) st.pop_back();
+  BAND_REC(o.k = opPop, [](WglSink &s) { s.pop_matrix(); });
+}
+void WglBands::rotated(double a, double x, double y, double z) {
+  p_->top() = p_->top().mul(rot_m(a, x, y, z));
+  BAND_REC((o.k = opRotD, o.d[0] = a, o.d[1] = x, o.d[2] = y, o.d[3] = z), [a, x, y, z](WglSink &s) { s.rotated(a, x, y, z); });
+}
+void WglBands::rotatef(float a, float x, float y, float z) {
+  p_->top() = p_->top().mul(rot_m(a, x, y, z));
+  BAND_REC((o.k = opRotF, o.f[0] = a, o.f[1] = x, o.f[2] = y, o.f[3] = z), [a, x, y, z](WglSink &s) { s.rotatef(a, x, y, z); });
+}
+void WglBands::translatef(float x, float y, float z) {
+  M4 t = M4::id();
+  t.m[12] = x; t.m[13] = y; t.m[14] = z;
+  p_->top() = p_->top().mul(t);
+  BAND_REC((o.k = opTrF, o.f[0] = x, o.f[1] = y, o.f[2] = z), [x, y, z](WglSink &s) { s.translatef(x, y, z); });
+}
+void WglBands::bind_texture(uint32_t t, uint32_t id) {
+  BAND_REC((o.k = opBind, o.u0 = t, o.u1 = id), [t, id](WglSink &s) { s.bind_texture(t, id); });
+}
+void WglBands::begin(uint32_t m) {
+  if (p_->rec) {
+    Block b;
+    std::memcpy(b.n_in, p_->cur_n, sizeof b.n_in);
+    std::memcpy(b.tc_in, p_->cur_tc, sizeof b.tc_in);
+    p_->blocks.push_back(b);
+  }
+  BAND_REC((o.k = opBegin, o.u0 = m, o.u1 = static_cast<uint32_t>(p_->blocks.size() - 1)), [m](WglSink &s) { s.begin(m); });
+}
+void WglBands::end() { BAND_REC(o.k = opEnd, [](WglSink &s) { s.end(); }); }
+void WglBands::tex_coord2fv(const float *v) {
+  p_->cur_tc[0] = v[0];
+  p_->cur_tc[1] = v[1];
+  const float a = v[0], b = v[1];
+  BAND_REC((o.k = opTc2fv, o.f[0] = a, o.f[1] = b), [a, b](WglSink &s) { const float t[2] = {a, b}; s.tex_coord2fv(t); });
+}
+void WglBands::tex_coord2f(float a, float b) {
+  p_->cur_tc[0] = a;
+  p_->cur_tc[1] = b;
+  BAND_REC((o.k = opTc2f, o.f[0] = a, o.f[1] = b), [a, b](WglSink &s) { s.tex_coord2f(a, b); });
+}
+void WglBands::array_element(int32_t i) {
+  Impl &p = *p_;
+  if (p.rec && p.cull && p.verts) p.track_vertex(p.verts + static_cast<size_t>(i) * 3);
+  if (p.norms && (p.nstride == 0 || p.nstride == 12) && p.ntype == 0x1406) std::memcpy(p.cur_n, p.norms + static_cast<size_t>(i) * 3, 12);
+  BAND_REC((o.k = opArr, o.u0 = static_cast<uint32_t>(i)), [i](WglSink &s) { s.array_element(i); });
+}
+void WglBands::normal3fv(const float *v) {
+  std::memcpy(p_->cur_n, v, 12);
+  const float a = v[0], b = v[1], c = v[2];
+  BAND_REC((o.k = opNrm, o.f[0] = a, o.f[1] = b, o.f[2] = c), [a, b, c](WglSink &s) { const float t[3] = {a, b, c}; s.normal3fv(t); });
+}
+void WglBands::vertex3fv(const float *v) {
+  if (p_->rec) p_->track_vertex(v);
+  const float a = v[0], b = v[1], c = v[2];
+  BAND_REC((o.k = opVtxV, o.f[0] = a, o.f[1] = b, o.f[2] = c), [a, b, c](WglSink &s) { const float t[3] = {a, b, c}; s.vertex3fv(t); });
+}
+void WglBands::vertex3f(float x, float y, float z) {
+  const float v[3] = {x, y, z};
+  if (p_->rec) p_->track_vertex(v);
+  BAND_REC((o.k = opVtx3f, o.f[0] = x, o.f[1] = y, o.f[2] = z), [x, y, z](WglSink &s) { s.vertex3f(x, y, z); });
+}
+void WglBands::enable(uint32_t c) { BAND_REC((o.k = opEn, o.u0 = c), [c](WglSink &s) { s.enable(c); }); }
+void WglBands::disable(uint32_t c) { BAND_REC((o.k = opDis, o.u0 = c), [c](WglSink &s) { s.disable(c); }); }
+void WglBands::blend_func(uint32_t a, uint32_t b) { BAND_REC((o.k = opBlend, o.u0 = a, o.u1 = b), [a, b](WglSink &s) { s.blend_func(a, b); }); }
+void WglBands::flush() { BAND_REC(o.k = opFlush, [](WglSink &s) { s.flush(); }); }
+#undef BAND_REC
+
+void WglBands::context_create() {
+  p_->used.clear();
+  p_->broadcast([](WglSink &s) { s.context_create(); });
+}
+void WglBands::hint(uint32_t t, uint32_t m) { p_->broadcast([t, m](WglSink &s) { s.hint(t, m); }); }
+void WglBands::enable_client_state(uint32_t a) { p_->broadcast([a](WglSink &s) { s.enable_client_state(a); }); }
+void WglBands::front_face(uint32_t m) { p_->broadcast([m](WglSink &s) { s.front_face(m); }); }
+void WglBands::viewport(int32_t x, int32_t y, int32_t w, int32_t h) {
+  p_->vx = x; p_->vy = y; p_->vw = w; p_->vh = h;
+  p_->broadcast([x, y, w, h](WglSink &s) { s.viewport(x, y, w, h); });
+}
+void WglBands::matrix_mode(uint32_t m) {
+  p_->mode = m;
+  p_->broadcast([m](WglSink &s) { s.matrix_mode(m); });
+}
+void WglBands::ortho(double l, double r, double b, double t, double n, double f) {
+  M4 o = M4::id();
+  o.m[0] = 2.0 / (r - l); o.m[5] = 2.0 / (t - b); o.m[10] = -2.0 / (f - n);
+  o.m[12] = -(r + l) / (r - l); o.m[13] = -(t + b) / (t - b); o.m[14] = -(f + n) / (f - n);
+  p_->top() = p_->top().mul(o);
+  p_->broadcast([l, r, b, t, n, f](WglSink &s) { s.ortho(l, r, b, t, n, f); });
+}
+void WglBands::light(uint32_t l, uint32_t pn, const float *v) {
+  const std::array<float, 4> a{v[0], v[1], v[2], v[3]};
+  p_->broadcast([l, pn, a](WglSink &s) { s.light(l, pn, a.data()); });
+}
+void WglBands::material(uint32_t fc, uint32_t pn, const float *v) {
+  const std::array<float, 4> a{v[0], v[1], v[2], v[3]};
+  p_->broadcast([fc, pn, a](WglSink &s) { s.material(fc, pn, a.data()); });
+}
+void WglBands::material_shininess(uint32_t fc, int32_t sh) { p_->broadcast([fc, sh](WglSink &s) { s.material_shininess(fc, sh); }); }
+bool WglBands::gen_textures(int32_t n, uint32_t *names) {   // only when this sink is the setup's sole sink: the driver's rule here
+  for (int32_t i = 0; i < n; ++i) {
+    uint32_t k = 1;
+    while (p_->used.count(k)) ++k;
+    p_->used.insert(k);
+    names[i] = k;
+  }
+  return gen_textures_mapped(n, names);
+}
+void WglBands::delete_textures(int32_t n, const uint32_t *names) {
+  std::vector<uint32_t> nm(names, names + (n > 0 ? n : 0));
+  for (uint32_t k : nm) p_->used.erase(k);
+  p_->broadcast([nm](WglSink &s) { s.delete_textures(static_cast<int32_t>(nm.size()), nm.data()); });
+}
+void WglBands::tex_parameteri(uint32_t t, uint32_t pn, int32_t v) { p_->broadcast([t, pn, v](WglSink &s) { s.tex_parameteri(t, pn, v); }); }
+void WglBands::tex_parameterf(uint32_t t, uint32_t pn, float v) { p_->broadcast([t, pn, v](WglSink &s) { s.tex_parameterf(t, pn, v); }); }
+void WglBands::tex_envi(uint32_t t, uint32_t pn, int32_t v) { p_->broadcast([t, pn, v](WglSink &s) { s.tex_envi(t, pn, v); }); }
+void WglBands::tex_image2d(uint32_t t, int32_t l, int32_t i, int32_t w, int32_t h, int32_t b, uint32_t f, uint32_t ty, const uint8_t *d) {
+  std::shared_ptr<std::vector<uint8_t>> data;
+  if (d && w > 0 && h > 0) {
+    const size_t bytes = static_cast<size_t>(w) * static_cast<size_t>(h) * (f == 0x1908 ? 4u : 3u);   // GL_RGBA else GL_RGB, bytes
+    data = std::make_shared<std::vector<uint8_t>>(d, d + bytes);
+  }
+  p_->broadcast([t, l, i, w, h, b, f, ty, data](WglSink &s) { s.tex_image2d(t, l, i, w, h, b, f, ty, data ? data->data() : nullptr); });
+}
+void WglBands::vertex_pointer(int32_t sz, uint32_t ty, int32_t st) {
+  p_->vsize = sz; p_->vtype = ty; p_->vstride = st;
+  p_->broadcast([sz, ty, st](WglSink &s) { s.vertex_pointer(sz, ty, st); });
+}
+void WglBands::normal_pointer(uint32_t ty, int32_t st) {
+  p_->ntype = ty; p_->nstride = st;
+  p_->broadcast([ty, st](WglSink &s) { s.normal_pointer(ty, st); });
+}
