+struct M4 {
+  double m[16];   // column-major, as GL
+  static M4 id() {
+    M4 r{};
+    r.m[0] = r.m[5] = r.m[10] = r.m[15] = 1.0;
+    return r;
+  }
+  M4 mul(const M4 &b) const {
+    M4 r{};
+    for (int c = 0; c < 4; ++c)
+      for (int rr = 0; rr < 4; ++rr) {
+        double s = 0.0;
+        for (int k = 0; k < 4; ++k) s += m[k * 4 + rr] * b.m[c * 4 + k];
+        r.m[c * 4 + rr] = s;
+      }
+    return r;
+  }
