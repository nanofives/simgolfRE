+  // the occluder: the right half of b's box, drawn after b (it stays over b's window-resolution glyphs)
+  const int32_t ox0 = (b.r.x0 + b.r.x1) / 2, ox1 = b.r.x1 + 4, oy0 = b.r.y0 - 3, oy1 = b.r.y1 + 3;
