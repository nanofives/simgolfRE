+        const uint32_t colour = set != 0 ? 0x80007fffu : 0x80000210u + (odd != 0 ? 0x1ef8u : 0u);
+        if (sel == idx) popup_gx(ctx, "drawTextSurface", {line, u32(add32(left, 0x24)), u32(add32(line_y, 7)), colour});
