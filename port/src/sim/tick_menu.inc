// ====================================================================================================================
// Session ML+0x43c..ML+0x664 : per-session setup after a title-menu selection (sel = ebx from the menu).
// Returns sQuit (original returns from mainLoop), sMenu (jmp ML+0x11875) or sFrame (reaches ML+0x664 -> FramePreamble).
// ====================================================================================================================
int Session(u32 F, int sel) {
    int mode = G32(GS(g_difficulty));                     // ML+0x43c
    cc("loadThemes", (mode != 6) ? 1 : 0);            // ML+0x44e loadThemes(mode!=6?1:0)  (setne dl)
    cc("startSoundSlot", 0x80);                           // ML+0x458 startSoundSlot(0x80)

    if (sel == -2) {                                // ML+0x460 cmp ebx,-2 : the QUIT path ML+0x469..ML+0x508
        cc("startSoundSlot", 0x2D);                       // ML+0x46b startSoundSlot(0x2d)
        cc("waitTicks", 0x3C, 0);                    // ML+0x474 waitTicks(0x3c, 0)
        StrCpy(kBuf, (GS(f_strpool_4c528c) + 32));                   // ML+0x47e..ML+0x4ab copy top-scores file name into kBuf
        int fd = cc("__open", (int)kBuf, 0x8301, 0x80);   // ML+0x4ad __open(name, 0x8301, 0x80)
        G32(GS(g_saveFd)) = fd;                        // ML+0x4bd
        cc("__write", fd, GS(g_topScores), 0x618);      // ML+0x4c2 __write(fd, g_topScores, 0x618) (the 0x618-byte top10 block)
        cc("__close", G32(GS(g_saveFd)));            // ML+0x4ce __close(fd)
        cc("promptAndSaveFile", 0, sel, 0);                   // ML+0x4d8 promptAndSaveFile(0, sel, 0)
        cc("playAudioFile", (GS(f_strpool_4c6ba4) + 16), 1);              // ML+0x4e4 playAudioFile(SMSG_closingfinal.bik, 1)
        cc("pumpLight");                             // ML+0x4e9 pumpLight()
        cc("playSound", 0x81, 0x64, 0, 0, 0);        // ML+0x4fb playSound(0x81,0x64,0,0,0)
        cc("showCreditsScreen");                             // ML+0x503 showCreditsScreen()
        cc("startSoundSlot", 0x81);                       // ML+0x50d startSoundSlot(0x81)
        FD(0x124C) = -1;                             // ML+0x51c SEH try-level before the dtor
        tc("PaletteCache::dtor", FA(0x2B0));                  // ML+0x527 Cache483010::dtor(F+0x2b0) (lea ecx,[F+0x2b0])
        return sQuit;                               // ML+0x52c.. the mainLoop epilogue (verifier-owned)
    }

    int flags = G32(GS(g_flags));                    // ML+0x545
    G32(GS(g_panelListMode)) = 5;                             // ML+0x54a
    G32((GS(g_rootInput) + 52)) = -1;                            // ML+0x559
    if (flags & 0x4000000) {                        // ML+0x554 test eax,4000000; ML+0x563 je (the championship flag)
        if (cc("startNewCourse") == 0) {                  // ML+0x565 startNewCourse(); ML+0x56c jne skips this
            G32(GS(g_flags)) &= 0xFBFFFFFF;          // ML+0x56e clear the championship flag
            return sMenu;                           // ML+0x578 jmp ML+0x11875
        }
        // startNewCourse != 0 -> fall to the loadWorldAssets block (ML+0x5a3)
    } else if (G32(GS(g_difficulty)) == 6) {              // ML+0x57d cmp [g_difficulty],esi(6)
        if (cc("loadGameBrowserScreen", 1, 0) == 0)              // ML+0x589 loadGameBrowserScreen(1,0); ML+0x593 je
            return sMenu;                           // jmp ML+0x11875
        cc("loadThemes", 1);                          // ML+0x59b loadThemes(1)
        // fall to the loadWorldAssets block (ML+0x5a3)
    } else {                                        // ML+0x5b7 the normal new-course path
        G32(GS(unk_00543cf4)) = 0;                        // ML+0x5c9
        G32(GS(g_courseIndex)) = 0;                        // ML+0x5d4
        G32(GS(g_cash_div100)) = (flags & 0x1000000) ? 0x2710 : 0x3E8;  // ML+0x5b7..ML+0x5da (neg/sbb/and 0x2328 + 0x3e8)
        int r = cc("courseActionMenu", 1);                  // ML+0x5df courseActionMenu(1) (thunk -> courseActionMenu)
        G32(GS(g_courseIndex)) = r;                        // ML+0x5ea
        if (r == -1)                                // ML+0x5ef je ML+0x11875
            return sMenu;
        GU8(GS(g_courseType)) = GU8((GS(g_courseTable) + 32) + (r + (menu_neg() == 3 ? 1 : 0)) * 46); // ML+0x5f5..ML+0x604 byte[g_courseTable+0x20 + result*46] (edx=r*23, *2)
        cc("loadWorldAssets");                             // ML+0x609 loadWorldAssets()
        cc("generateRandomCourse", G32(GS(g_courseIndex)));            // ML+0x615 generateRandomCourse(result)
        cc("rebuildHeightfield");                             // ML+0x61d rebuildHeightfield()
        int f2 = G32(GS(g_flags));                   // ML+0x622
        G32(GS(g_buildingUnlockLevel)) = menu_neg() == 4 ? 7 : 6;  // ML+0x627
        if (f2 & 0x1000000) {                       // ML+0x631 test; ML+0x636 je ML+0x656
            G32(GS(g_cash_div100)) = 0x2710;               // ML+0x638
            G32(GS(g_buildingUnlockLevel)) = 0x11;                 // ML+0x642
            G32(GS(g_amenityUnlockMask)) = 0x3FFF;               // ML+0x64c
        }
        GU16((GS(g_financeYears) + 14)) = GU16(GS(g_cash_div100));        // ML+0x656..ML+0x65d (mov dx,[g_cash_div100]; mov [g_financeYears+0xe],dx)
        return sFrame;                              // ML+0x664 falls into FramePreamble
    }
    // loadWorldAssets block ML+0x5a3 (reached by the championship's startNewCourse != 0 and mode == 6 fall-throughs)
    cc("loadWorldAssets");                                 // ML+0x5a3 loadWorldAssets()
    G32(GS(g_ui_542df8)) = 1;                            // ML+0x5a8
    return sFrame;                                  // ML+0x5b2 jmp ML+0x664
}

// MainLoopBody's loop (c3fy.cpp) from a frame's exit to the title menu (ML+0x11875) back to a frame head: Setup's slots, the
// menu (the selection in ebx), then Session. Session's sMenu goes back to the menu (ML+0x11875), sQuit is mainLoop's
// return (ML+0x544 ret), sFrame enters the frame at ML+0x664: rebuildTileCoverage, then the frame head ML+0x669, where the
// original's frame record is taken (so the rebuild is this step's and the next frame enters at the head).
FrameExit menu_session(u32 F) {
    for (;;) {
        MenuSeedSlots(F);
        const int sel = Menu(F);
        const int act = Session(F, sel);
        if (act == sQuit) return FrameExit::Quit;
        if (act == sFrame) {
            cc("rebuildTileCoverage");                 // ML+0x664
            return FrameExit::Frame;
        }
    }
}
