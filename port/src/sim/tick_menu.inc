    const short tx[7] = {0x42, 0x58, 0x199, 0x20D, 0x1AF, 0x210, 0};                    // text x at F+0xf6+4i
    for (int i = 0; i < 7; i++) {
        FW(0x150 + 4 * i) = gy[i];
        FW(0x152 + 4 * i) = gx[i];
        FW(0xF4 + 4 * i) = ty[i];
        FW(0xF6 + 4 * i) = tx[i];
    }
    FD(0x1F4) = (GS(f_strpool_4c6ba4) + 244);                                                              // ML+0x1b9 <text>
    FD(0x1F8) = (GS(f_strpool_4c6ba4) + 228);                                                              // ML+0x1c4 <text>
