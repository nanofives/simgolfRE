                        const unsigned char tag = (golfer == even)            // matchUpdate+0xcc6 jne
                                                      ? ref<unsigned char>((GS(g_golfers) + 187) + g)
                                                      : ref<unsigned char>((GS(g_golfers) + 187) + gr(ref<short>((GS(g_golfers) + 162) + g)));
                        kLogTick(0x60, tag);                                  // matchUpdate+0xcea
                    }
                }
                // Standings line (matchUpdate+0xcf2).
                ref<int>(GS(g_playerGolfer)) = -1;                                    // matchUpdate+0xcfc
                kBuildGolferName(ref<short>((GS(g_golfers) + 162) + g), 0);              // matchUpdate+0xd06
                unsigned tail;
                if (sumMine == sumPartner) {                                  // matchUpdate+0xd18 jne
                    appendAt(kAnd);
                    kBuildGolferName(golfer, 0);                              // matchUpdate+0xd51
                    appendAt(kTiedAt);
                    if (sumMine == sumPar) {                                  // matchUpdate+0xd90 jne
                        tail = kEvenPar;
                    } else {
                        const int d = sumMine - sumPar;
                        appendText(kItoa((d ^ (d >> 31)) - (d >> 31), kNumBuf, 10));   // matchUpdate+0xdb1
                        tail = (sumMine < sumPar) ? kUnderPar : kOverPar;     // matchUpdate+0xde9 jge
                    }
                } else {
                    unsigned lead;
                    if (sumPartner < sumMine) {                               // matchUpdate+0xe05 jle
                        if ((ref<unsigned char>((GS(g_golfers) + 25) + gr(odd)) & 0xf0) != 0 &&        // matchUpdate+0xe09
                            (ref<unsigned char>((GS(g_golfers) + 25) + gr(odd ^ 1)) & 0xf0) != 0)      // matchUpdate+0xe1e
                            kPlaySound((golfer == odd) + 0x2f, 100, 0, 0, 0); // matchUpdate+0xe37  sete
                        lead = kLeads;
                    } else {
                        if ((ref<unsigned char>((GS(g_golfers) + 25) + gr(odd)) & 0xf0) != 0 &&        // matchUpdate+0xe48
                            (ref<unsigned char>((GS(g_golfers) + 25) + gr(odd ^ 1)) & 0xf0) != 0)      // matchUpdate+0xe5d
                            kPlaySound((golfer != odd) + 0x2f, 100, 0, 0, 0); // matchUpdate+0xe76  setne
                        lead = kTrails;
                    }
                    appendAt(lead);
                    kBuildGolferName(golfer, 0);                              // matchUpdate+0xeb1
                    appendAt(kBy);
                    const int d = sumPartner - sumMine;                       // matchUpdate+0xee1
                    const int ad = (d ^ (d >> 31)) - (d >> 31);               // matchUpdate+0xeef  cdq/xor/sub
                    appendText(kItoa(ad, kNumBuf, 10));                       // matchUpdate+0xefc
                    tail = (ad > 1) ? kShots : kShot;                         // matchUpdate+0xf36 jg
                }
                appendAt(tail);
                kStartMessage(0x80002108, 1, ref<int>(GS(g_playerGolfer)));           // matchUpdate+0xf72
            }
        }
    }

    // ---- (6) the course-record tables, at the end of the round (matchUpdate+0xf7a) ------------------------------------
    if ((ref<unsigned>(GS(g_flags)) & 0x200000) == 0) {                        // matchUpdate+0xf84 jne
        const signed char myHole = ref<signed char>((GS(g_golfers) + 33) + g);          // matchUpdate+0xf8a
        if (myHole == 0x12 || ref<signed char>((GS(g_holes) + 520) + hr(myHole)) == 0) {   // matchUpdate+0xf92 je, matchUpdate+0xfa7 jne
            int total = 0;        // ebx: strokes over the holes played
            int grossPlus5 = 0;   // [esp+0x20]: same, with 5 per unplayed hole
            int overPar = 0;      // [esp+0x10]: (score - par) sum, +1 per unplayed hole
            int typeSum = 0;      // [esp+0x14]: sum of the per-hole type bits & 3
            int parSum = 0;       // [esp+0x1c]
            int allPlayed = 1;    // [esp+0x28]
            for (int h = 1; h <= 18; ++h) {                                   // matchUpdate+0xfd4..matchUpdate+0x1066
                if (h <= myHole) {                                            // matchUpdate+0xfd8 jg
                    const int sc = ref<signed char>((GS(g_golfers) + 35) + g + h);      // matchUpdate+0xfda
                    const int par = ref<signed char>((GS(g_holes) + 520) + (h - 1) * 0x208);   // matchUpdate+0xfe8
                    total += sc;
                    grossPlus5 += sc;
                    parSum += par;
                    overPar += sc - par;
                    typeSum += ref<unsigned char>((GS(g_golferTypeState) + 3) + ref<short>((GS(g_golfers) + 182) + g) * 0x2c + h) & 3;  // matchUpdate+0x1014
                } else {
                    grossPlus5 += 5;                                          // matchUpdate+0x1032
                    overPar += 1;                                             // matchUpdate+0x1035
                }
                if (h < ref<int>(GS(g_holesPlusOne)) && ref<signed char>((GS(g_golfers) + 35) + g + h) == 0)   // matchUpdate+0x1044, matchUpdate+0x104f
                    allPlayed = 0;                                            // matchUpdate+0x1051
            }
            kText[0] = 0;                                                     // matchUpdate+0x1070
            if (allPlayed != 0) {                                             // matchUpdate+0x1079 je
                int i = 0;
                for (;;) {                                                    // matchUpdate+0x1086
                    const int v = ref<int>(GS(g_bestRounds) + i * 4);
                    if (v == 0) {                                             // matchUpdate+0x108a je
                        ref<int>(GS(g_bestRounds) + i * 4) = total;                 // matchUpdate+0x10a6
                        kText[0] = 0;                                         // matchUpdate+0x10ad
                        break;
                    }
                    if (total < v) {                                          // matchUpdate+0x108e jl
                        if (i <= 8) {                                         // matchUpdate+0x10ba jg
                            int s = 0x1d;                                     // matchUpdate+0x10bc
                            unsigned q = (GS(g_bestRounds) + 32);                          // matchUpdate+0x10c1
                            for (;;) {                                        // matchUpdate+0x10c9
                                const int a = ref<int>(q);
                                if (a != 0) {                                 // matchUpdate+0x10d1 je
                                    kText[0] = 0;                             // matchUpdate+0x10d5
                                    ref<int>(q + 4) = a;                      // matchUpdate+0x10dc
                                    kAppendString(s - 1);                     // matchUpdate+0x10e3
                                    kAppendToBuffer(s);                       // matchUpdate+0x10e9
                                }
                                q -= 4;                                       // matchUpdate+0x10f5
                                --s;                                          // matchUpdate+0x10f8
                                if (s - 0x15 < i) break;                      // matchUpdate+0x1102 jge
                            }
                        }
                        ref<int>(GS(g_bestRounds) + i * 4) = total;                 // matchUpdate+0x110a
                        kText[0] = 0;                                         // matchUpdate+0x1111
                        break;
                    }
                    ++i;                                                      // matchUpdate+0x1093
                    if (GS(g_bestRounds) + i * 4 >= (GS(g_bestRounds) + 40)) goto afterRecords;  // matchUpdate+0x1099 jl
                }
                kBuildGolferName(golfer, 0);                                  // matchUpdate+0x1119
                kAppendToBuffer(i + 0x14);                                    // matchUpdate+0x1122
            }
          afterRecords:
            // New course record message (matchUpdate+0x112a).
            if (ref<int>(GS(g_holesPlusOne)) > 2 && ref<unsigned char>((GS(g_golfers) + 36) + g) != 0 &&        // matchUpdate+0x1131, matchUpdate+0x113f
                ref<int>((GS(f_w_4c2e00) + 12)) == -1 && allPlayed != 0 &&                               // matchUpdate+0x114c, matchUpdate+0x1158
                (ref<int>(GS(g_bestRounds)) == 0 || total < ref<int>(GS(g_bestRounds))) &&                // matchUpdate+0x1165, matchUpdate+0x1169
                total <= parSum) {                                                            // matchUpdate+0x1173 jg
                ref<int>((GS(f_w_4c2e00) + 12)) = golfer | 0x100;                        // matchUpdate+0x1185
                kBuildGolferName(golfer, 0);                                  // matchUpdate+0x118b
                kAppendToBuffer(0x14);                                        // matchUpdate+0x1192
                appendAt(kNewRecord);
                appendText(kItoa(total, kNumBuf, 10));                        // matchUpdate+0x11cc
                appendAt(kStrokesFor);
                appendText(kItoa(ref<int>(GS(g_holesPlusOne)) - 1, kNumBuf, 10));     // matchUpdate+0x1234
                appendAt(kHoles);
                typeSum += 1;                                                 // matchUpdate+0x1293
            }
            // Per-type bests and the <text> flag (matchUpdate+0x129a).
            const int difficulty = ref<int>(GS(g_difficulty));                      // matchUpdate+0x129a
            int score = typeSum;                                              // edi
            if (ref<short>((GS(g_golfers) + 164) + g) >= difficulty * 2 + 6) ++score;    // matchUpdate+0x12b1 jl
            const unsigned tb = static_cast<unsigned>(ref<short>((GS(g_golfers) + 182) + g)) * 0x2c;   // matchUpdate+0x12b4..matchUpdate+0x12c5
            const unsigned char best = ref<unsigned char>(GS(g_golferTypeState) + tb);   // matchUpdate+0x12c8
            if (grossPlus5 < static_cast<int>(best) || best == 0)             // matchUpdate+0x12d8 jl, matchUpdate+0x12dc jne
                ref<unsigned char>(GS(g_golferTypeState) + tb) = static_cast<unsigned char>(grossPlus5);   // matchUpdate+0x12de
            const signed char avg = ref<signed char>((GS(g_golferTypeState) + 1) + tb);        // matchUpdate+0x12e4
            ref<signed char>((GS(g_golferTypeState) + 1) + tb) = (avg == 0)                    // matchUpdate+0x12ec jne
                                                    ? static_cast<signed char>(overPar)
                                                    : static_cast<signed char>((avg + overPar) / 2);   // matchUpdate+0x1300
            if ((ref<unsigned char>((GS(g_golferTypeState) + 2) + tb + ref<int>(GS(g_holesPlusOne))) & 3) != 0 ||      // matchUpdate+0x1316 jne
                difficulty == 0 || ref<short>(GS(g_year)) == 0 ||                             // matchUpdate+0x131a, matchUpdate+0x1324
                (ref<int>(GS(g_cash_div100)) < 200 && ref<int>((GS(g_ui_56d1a8) + 8)) <= 0))                    // matchUpdate+0x1330, matchUpdate+0x1339
                ++score;                                                                      // matchUpdate+0x133b
            if (ref<int>((GS(g_activeObjectLevel) + 36)) != 0) score += ref<int>((GS(g_activeObjectLevel) + 36));     // matchUpdate+0x1343
            if (ref<unsigned char>((GS(g_golfers) + 24) + g) == 0) {                    // matchUpdate+0x134f jne
                const unsigned char tflags = ref<unsigned char>((GS(g_golferTypeState) + 2) + tb);   // matchUpdate+0x1351
                if (score >= (1 << (tflags & 7)) && (tflags & 7) < 5) {       // matchUpdate+0x1365 jl, matchUpdate+0x136b jge
                    ref<unsigned>((GS(g_golfers) + 16) + g) |= 0x80000000;              // matchUpdate+0x1378
                    ref<short>((GS(g_golfers) + 158) + g) = static_cast<short>(0xfff8);  // matchUpdate+0x137e
                }
            }
        }
    }

    // ---- (7) advance to the next hole (matchUpdate+0x1387) -------------------------------------------------------------
    const signed char nextHole = ref<signed char>((GS(g_golfers) + 33) + g) + 1;        // matchUpdate+0x1393
    ref<signed char>((GS(g_golfers) + 33) + g) = nextHole;                              // matchUpdate+0x1397
    if ((ref<unsigned>(GS(g_flags)) & 0x4200000) != 0) {                       // matchUpdate+0x13a0 test, matchUpdate+0x13a8 je
        if (ref<signed char>(GS(g_holes) + hr(nextHole)) == 0)                 // matchUpdate+0x13b8 jne
            ref<signed char>((GS(g_golfers) + 33) + g) = 1;                             // matchUpdate+0x13ba  wrap to hole 1
        ref<short>((GS(g_golfers) + 190) + g) += static_cast<short>(ref<int>(GS(g_holesPlusOne)) * 2);   // matchUpdate+0x13ca
        if (ref<signed char>((GS(g_golfers) + 35) + g + ref<signed char>((GS(g_golfers) + 33) + g)) != 0)  // matchUpdate+0x13e1 je
            kPatronEvent(golfer);                                             // matchUpdate+0x13e8
    } else {
        if (ref<signed char>(GS(g_holes) + hr(nextHole)) == 0) {               // matchUpdate+0x1400 je
            kPatronEvent(golfer);                                             // matchUpdate+0x164b
            return;
        }
        const signed char partnerHole = ref<signed char>((GS(g_golfers) + 33) + gr(ref<short>((GS(g_golfers) + 162) + g)));   // matchUpdate+0x1410
        if (partnerHole == 0 || partnerHole == 0x13) {                        // matchUpdate+0x1418 je, matchUpdate+0x1420 je
            kPatronEvent(golfer);                                             // matchUpdate+0x164b
            return;
        }
    }

    // The VIP's last-hole line (matchUpdate+0x1426).
    if (ref<signed char>((GS(g_holes) + 520) + hr(ref<signed char>((GS(g_golfers) + 33) + g))) == 0) {   // matchUpdate+0x143d jne
        const unsigned kind = ref<unsigned char>((GS(g_golfers) + 24) + g) & 0xe0;      // matchUpdate+0x1449
        if (kind == 0x40 || kind == 0x60) {                                   // matchUpdate+0x1451 je, matchUpdate+0x1456 jne
            setTextAt(kind == 0x40 ? kCommissioner : kCeo);                   // matchUpdate+0x145c / matchUpdate+0x1463
            kBuildGolferName(golfer, 0);                                      // matchUpdate+0x148e
            appendAt(kLastHole);
            kAppendOpinion(ref<short>((GS(g_golfers) + 164) + g), 0);                    // matchUpdate+0x14cc
            appendAt(kQuoteTail);
            kStartMessage(0x80000210, 1, golfer);                             // matchUpdate+0x150a
        }
    }

    // ---- the rolling satisfaction average and the end-of-hole decay (matchUpdate+0x1512) -------------------------------
    ref<short>((GS(g_golfers) + 180) + g) = static_cast<short>(ref<short>((GS(g_golfers) + 180) + g) * 7 / 8) +
                                 ref<short>((GS(g_golfers) + 164) + g);                  // matchUpdate+0x1519..matchUpdate+0x1532
    if ((ref<unsigned>((GS(g_golfers) + 16) + g) & 0x100000) != 0)                      // matchUpdate+0x1544 je
        ref<unsigned char>((GS(g_golfers) + 55) + g + ref<signed char>((GS(g_golfers) + 33) + g)) =
            ref<unsigned char>((GS(g_golfers) + 180) + g);                               // matchUpdate+0x1553
    else
        ref<short>((GS(g_golfers) + 180) + g) = ref<short>((GS(g_golfers) + 164) + g);              // matchUpdate+0x1563
    ref<unsigned char>((GS(g_golfers) + 92) + g + ref<signed char>((GS(g_golfers) + 33) + g)) =
        ref<unsigned char>((GS(g_golfers) + 164) + g);                                   // matchUpdate+0x1577
    ref<signed char>((GS(g_golfers) + 54) + g) -= static_cast<signed char>(kSign(ref<signed char>((GS(g_golfers) + 54) + g)));  // matchUpdate+0x1586

    if ((ref<unsigned char>((GS(g_golfers) + 24) + g) & 0xe0) == 0x40) {                // matchUpdate+0x15a8 je
        const int v = (ref<signed char>((GS(g_golfers) + 33) + g) + 6) * ref<short>((GS(g_golfers) + 164) + g) *
                      ref<int>(GS(g_difficulty));                                   // matchUpdate+0x161c..matchUpdate+0x1623
        ref<short>((GS(g_golfers) + 164) + g) = static_cast<short>(ref<short>((GS(g_golfers) + 164) + g) - v / 0xa0);   // matchUpdate+0x1638
        return;
    }
    const int par = ref<short>((GS(g_golferTypeState) + 42) + static_cast<unsigned>(ref<short>((GS(g_golfers) + 182) + g)) * 0x2c);   // matchUpdate+0x15c2
    const int n = (par + ref<signed char>((GS(g_golfers) + 33) + g) + 6) *
                  (ref<short>((GS(g_golfers) + 164) + g) + ref<int>(GS(g_difficulty)) - 1) *
                  (ref<int>(GS(g_difficulty)) + 1);                                 // matchUpdate+0x15ca..matchUpdate+0x15e3
    ref<short>((GS(g_golfers) + 164) + g) = static_cast<short>(
        ref<short>((GS(g_golfers) + 164) + g) - n / ((ref<int>((GS(g_activeObjectLevel) + 52)) * 5 + 0xf) * 8));   // matchUpdate+0x15e6..matchUpdate+0x15f9
}
