    }
    if (esi == 0) return H2_Rebuild(F);               // ML+0x1146b / ML+0x1146d
L_a2f: {
        int h = G32(GS(g_holesPlusOne));                      // ML+0x1146f
        G32(GS(g_cash_div100)) = G32(GS(g_cash_div100)) - esi;      // ML+0x11474 / ML+0x11483 / ML+0x11485
        u32 ha = (GS(g_holes) + 496) + H2_hole(h);            // ML+0x1147a..ML+0x11492
        G32(ha) = G32(ha) + esi;                      // ML+0x1148b / ML+0x11499 / ML+0x1149d
        cc("pointsPopup", H2_neg(esi), H2_W(FD(0x1c)), H2_W(FD(0x24)), -1);   // ML+0x114bd pointsPopup
        int rem = H2_Rem100();                        // ML+0x114c2..ML+0x114d2
        u32 a = (GS(g_financeYears) + 6) + H2_row(rem);
        GU16(a) = (u16)(GU16(a) - (u16)esi);          // ML+0x114d7
    }
    return H2_Rebuild(F);                             // -> ML+0x114df
}

