// ---------------------------------------------------------------------------------------------------------------
// ML+0x7cb7..ML+0x8032: the hole HUD. For hole h = [g_holesPlusOne] below 0x13 whose record (g_holes+0x8 + 0x208 h)
// has a non-zero dword +0 and point B (+0x10 / +0x14, B.x non-zero) on screen, the distance word at record - 4
// (g_holes+0x4 + 0x208 h) is computed once (while 0) as __ftol(sqrt(625 * (dx * dx + dy * dy))) between point A
// (+0 / +4) and point B, plus a quarter of its excess over 0xc8; the par p (2..6) comes from that word (+0x19 when
// byte +0x1f8 has bits 0x60, minus 25 * [g_objectTypeLevel+0x28] above 0x12c); three lines (f_strpool_4c4970+0x8 + h, the word +
// f_strpool_4c4f98+0x84, f_strpool_4c64a8+0x28 + p) are drawn at B's screen point minus [F+0x40]; the string f_strpool_4c64a8+0x10 goes at A's
// screen point when the date has bit 2 or 3 set.
int P4_sqrtFtol(u32 F) {
    int p = FA(0x34);
    return (int)ftol_low32(std::sqrt(static_cast<double>(G32(p))));   // ML+0x7d6f fild, ML+0x7d73 fsqrt, ML+0x7d75 __ftol
}

void P4_holeHud(u32 F) {
    int ecx = G32(GS(g_holesPlusOne));                                                // ML+0x7cb7
    if (ecx >= 0x13) return;                                                  // ML+0x7cbd / ML+0x7cc0 jge ML+0x8032
    u32 rec = (u32)ecx * 0x208u;                                              // ML+0x7cc6..ML+0x7ccd
    if (G32(rec + (GS(g_holes) + 8)) == 0) return;                                   // ML+0x7cd0 / ML+0x7cd8
    int c = G32(rec + (GS(g_holes) + 24));                                            // ML+0x7cde
    if (c == 0) return;                                                       // ML+0x7ce4 / ML+0x7ce6
    int e = G32(rec + (GS(g_holes) + 28));                                            // ML+0x7cec
    if (cc("tileToScreen", c, e, FA(0xd8), FA(0xd0)) == 0) return;                // tileToScreen ML+0x7d04, ML+0x7d0e
    u32 esi = (u32)G32(GS(g_holesPlusOne)) * 0x208u;                                  // ML+0x7d14..ML+0x7d20
    if (G16(esi + (GS(g_holes) + 4)) == 0) {                                         // ML+0x7d23 / ML+0x7d2b jne ML+0x7da5
        int eax = G32(esi + (GS(g_holes) + 8));                                      // ML+0x7d2d
        int ebx = G32(esi + (GS(g_holes) + 24));                                      // ML+0x7d33
        int ebp = G32(esi + (GS(g_holes) + 28));                                      // ML+0x7d39
        int dx = eax - ebx;                                                   // ML+0x7d3f
        if (dx < 0) dx = (int)(0u - (u32)dx);                                 // ML+0x7d41..ML+0x7d4e (cdq, xor, sub)
        int dy = G32(esi + (GS(g_holes) + 12)) - ebp;                                 // ML+0x7d44 / ML+0x7d4c
        if (dy < 0) dy = (int)(0u - (u32)dy);                                 // ML+0x7d50..ML+0x7d53
        u32 s = (u32)dy * (u32)dy + (u32)dx * (u32)dx;                        // ML+0x7d57..ML+0x7d5d
        s *= 625u;                                                            // ML+0x7d5f..ML+0x7d68 (four lea x5)
        FD(0x34) = (int)s;                                                    // ML+0x7d6b
        int r = P4_sqrtFtol(F);                                               // ML+0x7d6f..ML+0x7d75
        u16 cx = (u16)r;                                                      // ML+0x7d7a
        G16(esi + (GS(g_holes) + 4)) = (short)cx;                                    // ML+0x7d82
        if ((short)cx > 0xc8) {                                               // ML+0x7d7d / ML+0x7d89 jle ML+0x7da5
            int t = ((int)(short)cx - 0xc8) / 4;                              // ML+0x7d8b..ML+0x7d99 (cdq, and 3, add, sar 2)
            // ML+0x7d9c add eax, ecx: only the low word is stored, so the upper half of ecx (|dx| >> 16) drops out
            G16(esi + (GS(g_holes) + 4)) = (short)(u16)((u32)t + (u32)cx);           // ML+0x7d9e
        }
    }
    // ML+0x7da5
    u8 al = GU8(esi + (GS(g_holes) + 512));                                            // ML+0x7da5
    int v = G16(esi + (GS(g_holes) + 4));                                            // ML+0x7dab movsx
    if ((al & 0x60) != 0) v += 0x19;                                          // ML+0x7db2 / ML+0x7db4 / ML+0x7db6
    if (v > 0x12c) {                                                          // ML+0x7db9 / ML+0x7dbf jle
        int d = G32((GS(g_objectTypeLevel) + 40));                                              // ML+0x7dc1
        int m5 = (int)((0u - (u32)d) * 4u - (u32)d);                          // ML+0x7dc7..ML+0x7dce (neg, shl 2, sub)
        v = (int)((u32)v + (u32)m5);                                          // ML+0x7dd0
        v = (int)((u32)v + (u32)m5 * 4u);                                     // ML+0x7dd2 lea ecx, [ecx + eax*4]
    }
    int ebp = 3;                                                              // ML+0x7dd8
    if (v <= 0x32) ebp = 2;                                                   // ML+0x7dd5 / ML+0x7ddd jg / ML+0x7ddf
    if (v >= 0xfa) ebp = 4;                                                   // ML+0x7de4 / ML+0x7dea jl / ML+0x7dec
    if (v >= 0x1db) ebp = 5;                                                  // ML+0x7df1 / ML+0x7df7 jl / ML+0x7df9
    if (v > 0x271) ebp = 6;                                                   // ML+0x7dfe / ML+0x7e04 jle / ML+0x7e06
    tc("setDrawTarget", Root(), GS(g_font51b360), 0, 0, 0);                              // setDrawTarget ML+0x7e1c
    StrCpy(kBuf, (GS(f_strpool_4c4970) + 8));                                                 // ML+0x7e21..ML+0x7e51
    int r = Itoa(G32(GS(g_holesPlusOne)), GS(g_textBuf), 10);                            // __itoa ML+0x7e53 (hole read ML+0x7e33)
    int ebx = FD(0x40);                                                       // ML+0x7e5f
    StrCat(kBuf, (u32)r);                                                     // ML+0x7e58..ML+0x7e92
    cc("drawCenteredText2", (int)kBuf, FD(0xd8), FD(0xd0) - ebx - 0x1a, (int)0x80007FFF);   // drawCenteredText2 ML+0x7ea5
    int h = G32(GS(g_holesPlusOne));                                                  // ML+0x7eaa
    GU8(GS(g_textBuffer)) = 0;                                                      // ML+0x7ebd
    r = Itoa((int)G16((u32)h * 0x208u + (GS(g_holes) + 4)), GS(g_textBuf), 10);         // ML+0x7eb1..ML+0x7ec4, __itoa ML+0x7ecd
    StrCat(kBuf, (u32)r);                                                     // ML+0x7ed2..ML+0x7efa
    StrCat(kBuf, (GS(f_strpool_4c4f98) + 132));                                                 // ML+0x7efc..ML+0x7f33
    cc("drawCenteredText2", (int)kBuf, FD(0xd8), FD(0xd0) - ebx - 0xd, (int)0x80007FFF);    // drawCenteredText2 ML+0x7f46
    StrCpy(kBuf, (GS(f_strpool_4c64a8) + 40));                                                 // ML+0x7f4b..ML+0x7f76
    r = Itoa(ebp, GS(g_textBuf), 10);                                            // __itoa ML+0x7f78
    StrCat(kBuf, (u32)r);                                                     // ML+0x7f7d..ML+0x7fb6
    cc("drawCenteredText2", (int)kBuf, FD(0xd8), FD(0xd0) - ebx, (int)0x80007FFF);          // drawCenteredText2 ML+0x7fc6
    u32 rec2 = (u32)G32(GS(g_holesPlusOne)) * 0x208u;                                 // ML+0x7fcb..ML+0x7fe7
    if (cc("tileToScreen", G32(rec2 + (GS(g_holes) + 8)), G32(rec2 + (GS(g_holes) + 12)), FA(0xd8), FA(0xd0)) == 0) return;   // tileToScreen ML+0x7ff9, ML+0x8003
    if ((GU8(GS(g_date)) & 0xc) == 0) return;                                 // ML+0x8005 / ML+0x800c
    cc("drawCenteredText2", (GS(f_strpool_4c64a8) + 16), FD(0xd8), FD(0xd0) - ebx, (int)0x80007FFF);         // drawCenteredText2 ML+0x802a
}

