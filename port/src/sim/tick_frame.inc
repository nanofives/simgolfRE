            if (ebp == -1) goto L_feb8;               // ML+0x10729
            if (ebp == 0) goto L_feb8;                // ML+0x10732
            StrCpy(kBuf, (GS(f_strpool_4c4f98) + 496));                 // ML+0x1073a..ML+0x10760
            StrCat(kBuf, GS(f_tab_buildItems_4c26b0) + 20u * (u32)(int)dx);   // ML+0x1075a / ML+0x10762..ML+0x1079e
