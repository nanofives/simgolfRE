        StrCpy(kBuf, (GS(f_strpool_4c64a8) + 1040));                                             // ML+0x6dcc..ML+0x6df7
        int e = G32((GS(g_holes) + 544));                                              // ML+0x6dec (edx)
        if (e == 0) StrCpy(kBuf, (GS(f_strpool_4c64a8) + 1008));                                 // ML+0x6df5 / ML+0x6df9, ML+0x6dfb..ML+0x6e1c
        int bp = G32((GS(g_holes) + 528));                                             // ML+0x6e1e
