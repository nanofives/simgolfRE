// ML+0x3cb9..ML+0x3e6c: the object kind n == 2 body (after ML+0x3c0a). nearestHole is called and its result
// discarded; [F+0x18] = ([g_tileVariant] % 4) + 0x2e; a 4-bit neighbour mask of tiles with bit 0x1000 and the same
// [g_tileLevel] byte, rotated like the first one; bit 0x100 of the tile word cleared, the word kept in [F+0x2c];
// then either a typed sprite (bit 4 of [g_flags]) or the fixed sprite g_surfaces568258 + 44 * ((mask - 1) & 15)
// at the screen point ([F+0xe0], [F+0xe4]). ebx is the register the caller's ML+0x3f0e reads.
void P2_obj2(u32 F, int& ebx) {
    int bb = FD(0x30);                         // ML+0x3cb9
    int aa = FD(0x20);                         // ML+0x3cbd
    int m = 0;                                 // esi ML+0x3cc3
    cc("nearestHole", aa, bb);                    // ML+0x3cc5 nearestHole; its result % 4 (ML+0x3ccd..ML+0x3cd8) is overwritten at ML+0x3cdd
    int ti = FD(0x14);                         // edi ML+0x3cd9
    FD(0x18) = (int)GU8(GS(g_tileVariant) + ti) % 4 + 0x2e;   // ML+0x3cdd..ML+0x3cf6
    for (int i = 0; i < 0x20; i += 8) {        // ML+0x3cf4 ecx = 0; ML+0x3d47..ML+0x3d4d
        int ni = (G32(GS(f_tab_dirDx_4c2878) + i) + FD(0x20)) * 50 + G32(GS(f_tab_dirDy_4c2898) + i) + FD(0x30);   // ML+0x3cfa..ML+0x3d1b
        m >>= 1;                               // ML+0x3d06
        if ((GU16(GS(g_tileFlags) + 2 * ni) & 0x1000) != 0x1000) continue;   // ML+0x3d1d..ML+0x3d30 -> ML+0x3d47
        if (GU8(GS(g_tileLevel) + ti) == GU8(GS(g_tileLevel) + ni)) m |= 8;     // ML+0x3d32..ML+0x3d40
        ti = FD(0x14);                         // ML+0x3d43
    }
    GU8((GS(g_tileFlags) + 1) + 2 * ti) &= 0xfe;          // ML+0x3d4f
    FUW(0x2c) = GU16(GS(g_tileFlags) + 2 * ti);     // ML+0x3d57 / ML+0x3d5f
    int r = G32(GS(g_cameraRot)) / 2;               // ML+0x3d64..ML+0x3d6c
    if (r > 0) {                               // ML+0x3d6e / ML+0x3d70
        do {
            int lo = (m & 1) << 3;             // ML+0x3d72..ML+0x3d77
            m >>= 1;                           // ML+0x3d7a
            m |= lo;                           // ML+0x3d7c
        } while (--r != 0);                    // ML+0x3d7e / ML+0x3d7f
    }
    if (GU8(GS(g_flags)) & 4) {                 // ML+0x3d81 / ML+0x3d88
        int t = G16(GS(g_maskSpriteTable) + 4 * m);       // edi ML+0x3d8e
        int rot = G16((GS(g_maskSpriteTable) + 2) + 4 * m);     // eax ML+0x3d96
        if (t == 0x1a5) rot = (rot + 1) & 3;   // ML+0x3d9e..ML+0x3da7
        if (rot == -1) rot = (FD(0x20) - 2 * FD(0x30)) & 3;   // ML+0x3daa..ML+0x3dbe
        int last = G32(GS(g_sheetCols) + 4 * t) - 1;   // esi ML+0x3dc1 / ML+0x3dcc
        int f10 = FD(0x10);                    // edx ML+0x3dc8
        int fr = last;                         // ecx ML+0x3dd0
        if (f10 != -1) {                       // ML+0x3dcd / ML+0x3dd2
            int tj = FD(0x14);                 // ebx ML+0x3dd4
            fr = f10;                          // ML+0x3dd8
            if ((int)GU8(GS(tile_anim_frame) + tj) >= last) {   // ML+0x3dda..ML+0x3de4
                GU16(GS(g_tileFlags) + 2 * tj) = (u16)(FU(0x2c) & 0xFFFFBFFFu);   // ML+0x3de6..ML+0x3def
                GU8(GS(tile_anim_frame) + tj) = 0xff;   // ML+0x3df7
            }
            ebx = FD(0xc);                     // ML+0x3dfe
        }
        int cell = cc("cellAt", t, fr, rot); // ML+0x3e05 cellAt
        int k18 = FD(0x18);                    // ML+0x3e0a
        G32(GS(unk_005a9cc8)) = cell;                // ML+0x3e18
        cc("addSprite", FD(0xe0), FD(0xe4), FD(0xe4), 0x2a, 0x2a, cell, 4, k18);   // ML+0x3e2c addSprite
    } else {                                   // ML+0x3e36
        int j = (m - 1) & 0xf;                 // ML+0x3e36 / ML+0x3e3b
        cc("addSprite", FD(0xe0), FD(0xe4), 0, 0x20, 0xe, (int)(GS(g_surfaces568258) + 44 * j), 4, 0x31);   // ML+0x3e64 addSprite
    }
}

// ML+0x3b5c..ML+0x3f3c: placed objects. n = (low byte of the tile word) & 0x1f; for tile type 0x15 or 0x16 with
// n != 0: screen point of the object from worldToScreen worldToScreen into [F+0xe0] / [F+0xe4] (offset from the record
// byte [f_tab_buildItems_4c26b0+0x10 + 20 * (n - 1)]), draw target g_font51b360, then buildSceneSprites buildSceneSprites or, for n - 1 == 2,
// the P2_obj2 body; then (objectAt flag 0x40 clear, bit 1 of [g_date] set, n - 1 >= 6) the text buffer gets the
// prefix f_strpool_4c6980+0x28 / f_strpool_4c6980+0x20 selected by [g_editQueueMode+0x400 + 4 * n] and the record name f_tab_buildItems_4c26b0 + 20 * (n - 1).
void P2_objects(u32 F) {
    int ti = FD(0x14);                         // eax ML+0x3b5c
    int n = GU8(GS(g_tileFlags) + 2 * ti) & 0x1f;   // ebp ML+0x3b60 / ML+0x3b6d / ML+0x3b72
    u8 ty = GU8(GS(g_tileType) + ti);              // al ML+0x3b67
    if (ty != 0x15 && ty != 0x16) return;      // ML+0x3b70..ML+0x3b78 -> ML+0x3f3c
    if (n == 0) return;                        // ML+0x3b7e / ML+0x3b80 -> ML+0x3f3c
    int k = G32((GS(g_editQueueMode) + 1024) + 4 * n);           // esi ML+0x3b86
    n -= 1;                                    // ML+0x3b8d
    int x, y;
    if (n == 7) k = 1;                         // ML+0x3b8e / ML+0x3b91 / ML+0x3b97
    int ebx = n * 20;                          // ML+0x3b9c / ML+0x3ba7 (and ML+0x3c5b / ML+0x3c66)
    int dz = G8((GS(f_tab_buildItems_4c26b0) + 16) + ebx);             // ML+0x3bad / ML+0x3c72
    if (n == 7 || n < 6 || n == 5) {           // ML+0x3c49 / ML+0x3c4c (ML+0x3c55 cannot be taken: n < 6 jumped first)
        FD(0xc) = ebx;                         // ML+0x3bb8
        int off = (dz * 1024 - 0x400) / 2;     // ML+0x3bbc..ML+0x3bce
        y = (FD(0x30) << 10) + off + 0x200;    // ML+0x3bb4 / ML+0x3bd0 / ML+0x3bd4
        x = (FD(0x20) << 10) + off + 0x200;    // ML+0x3bdb..ML+0x3be3
    } else {                                   // ML+0x3c5b
        FD(0xc) = ebx;                         // ML+0x3c7f
        int off = (int)((u32)(k + dz - 2) << 10) / 2;   // ML+0x3c7b..ML+0x3c8d (and ML+0x3c9a..ML+0x3ca8)
        y = off + (FD(0x30) << 10) + 0x200;    // ML+0x3c89 / ML+0x3c8f / ML+0x3c92
        x = off + (FD(0x20) << 10) + 0x200;    // ML+0x3c9e / ML+0x3caa / ML+0x3cad
    }
    cc("worldToScreen", x, y, FA(0xe0), FA(0xe4), 0);   // ML+0x3beb worldToScreen (ML+0x3bea push x)
    int root = Root();                         // ML+0x3bf0
    k -= 1;                                    // ML+0x3bf9
    tc("setDrawTarget", root, GS(g_font51b360), 0, 0, 0); // ML+0x3c05 setDrawTarget
    if (n == 2) {                              // ML+0x3c0a / ML+0x3c0d -> ML+0x3cb9
        P2_obj2(F, ebx);
    } else {                                   // ML+0x3c13
        int hb = GU8(GS(g_tileVariant) + FD(0x14));   // ML+0x3c13..ML+0x3c1d
        cc("buildSceneSprites", n, k, FD(0xe0), FD(0xe4), FD(0x3c), FD(0x38), hb);   // ML+0x3c3c buildSceneSprites
    }
    // ML+0x3e6c
    int o = cc("objectAt", FD(0x20), FD(0x30));   // ML+0x3e76 objectAt
    if (GU8((u32)(o << 4) + (GS(g_placed_objects) + 7)) & 0x40) return;   // ML+0x3e7b..ML+0x3e88
    if (!(GU8(GS(g_date)) & 2)) return;        // ML+0x3e8e / ML+0x3e95
    if (n < 6) return;                         // ML+0x3e9b / ML+0x3e9e
    if (n == 5) return;                        // ML+0x3ea4 / ML+0x3ea7 (cannot be taken after ML+0x3e9e)
    int sel = G32(GS(g_objectTypeLevel) + 4 * n);         // ebp ML+0x3ead
    GU8(kBuf) = 0;                             // ML+0x3eb4
    if (sel == 2) StrCpy(kBuf, (GS(f_strpool_4c6980) + 40));    // ML+0x3ebb / ML+0x3ebe; ML+0x3ec0..ML+0x3ee3
    if (sel == 3) StrCpy(kBuf, (GS(f_strpool_4c6980) + 32));    // ML+0x3ee5 / ML+0x3ee8; ML+0x3eea..ML+0x3f0c
    StrCat(kBuf, (u32)(ebx + GS(f_tab_buildItems_4c26b0)));     // ML+0x3f0e..ML+0x3f3a
}

// ML+0x2d9a..ML+0x3f61: one tile (a, b).
void P2_tile(u32 F, int& a, int& b) {
    if (cc("tileBlocked", a, b) != 0) return;     // ML+0x2d9c tileBlocked / ML+0x2da6 -> ML+0x3f61
    FD(0x10) = -1;                             // ML+0x2db0
    int idx = b + a * 50;                      // ebx ML+0x2dac / ML+0x2db8 / ML+0x2dbb
    FD(0x14) = idx;                            // ML+0x2dbe
    if (GU16(GS(g_tileFlags) + 2 * idx) & 0x4000)   // ML+0x2dc2..ML+0x2dd3
        FD(0x10) = GU8(GS(tile_anim_frame) + idx);      // ML+0x2dd5..ML+0x2ddd
    if (cc("tileToScreen", a, b, FA(0x3c), FA(0x38)) == 0) return;   // ML+0x2ded tileToScreen / ML+0x2df7 -> ML+0x3f61
    P2_bars(F, idx);                           // ML+0x2dfd..ML+0x2eab
    u32 ecx = P2_label(F, a, idx);             // ML+0x2eab..ML+0x308f
    P2_paths(F, idx, ecx);                     // ML+0x308f..ML+0x33e4
    P2_scenery(F);                             // ML+0x33e4..ML+0x3b5c
    P2_objects(F);                             // ML+0x3b5c..ML+0x3f3c
    // ML+0x3f3c: step the screen point back by one tile
    int g = G32(GS(g_tileStep4c2840));                   // ML+0x3f3c
    int x3c = FD(0x3c);                        // ML+0x3f41
    a = FD(0x20);                              // ebp ML+0x3f45
    b = FD(0x30);                              // esi ML+0x3f49
    FD(0x3c) = x3c - g;                        // ML+0x3f4d / ML+0x3f53
    FD(0x38) = FD(0x38) - FD(0x40);            // ML+0x3f4f..ML+0x3f5d
}

