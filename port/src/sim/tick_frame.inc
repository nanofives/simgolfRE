        c = cc("cellAt", 0x23c, (G32(GS(g_date)) + esi2) % G32((GS(g_sheetCols) + 2288)), 0);  // ML+0x1c72 cellAt
        G32(GS(unk_005a9cc8)) = c;                                                       // ML+0x1c7e
        cc("addSprite", G32(GS(g_tileStep4c2840)) / 2 + FD(0x50), FD(0x44) - FD(0x40) / 3, FD(0x44), 0x3c, 0x3c, c, 4, 0xb2);   // ML+0x1cba addSprite
    }
}

// ---- ML+0x1cc2..ML+0x1f22: the same for the [F+0x84] side, variant 1, drawn at - half the g_tileStep4c2840 width.
void P1_t11_411282(u32 F, int ebp, int ebx) {
    if ((FD(0x84) & G8(GS(g_tileWallMask) + FD(0x14))) == 0) return;                       // ML+0x1cd6 -> ML+0x1f25
    int eax = G32(GS(g_cameraRot)) & 7;                                                 // ML+0x1ce1
    u32 esi = GS(f_tab_dirDx_4c2878) + eax * 4;                                                // ML+0x1ce4
    u32 edi = GS(f_tab_dirDy_4c2898) + eax * 4;                                                // ML+0x1ceb
    if (G8(GS(g_tileType) + ebx + (G32(esi) + ebp) * 50 + G32(edi)) != 0x11) return;   // ML+0x1d09 -> ML+0x1f25
    eax = cc("cornerHeights", ebp, ebx, (G32(GS(g_cameraRot)) + 1) & 7, 0);                 // ML+0x1d1e cornerHeights
    int edx = (G32(GS(g_cameraRot)) + 3) & 7;                                           // ML+0x1d23
    int ecx = G32(esi);                                                            // ML+0x1d29
    FD(0x18) = eax;                                                                // ML+0x1d33
    eax = cc("cornerHeights", ecx + ebp, ebx + G32(edi), edx, 0);                      // ML+0x1d42 cornerHeights
    eax -= FD(0x18);                                                               // ML+0x1d4e
    if (eax <= 3) {                                                                // ML+0x1d53 jg
        eax = (eax - 1) * G32(GS(f_w_4c2e00)) * G32(GS(g_zoomScale));                       // ML+0x1d59..ML+0x1d68
        int edi2 = ebp * 7;
        int esi2 = eax / 8;                                                        // ML+0x1d6f..ML+0x1d8b
        int c = cc("cellAt", 0x237, (G32(GS(g_date)) + edi2) % G32((GS(g_sheetCols) + 2268)), 1);   // ML+0x1d94 cellAt
        G32(GS(unk_005a9cc8)) = c;                                                       // ML+0x1d9c
        if (esi2 > 0) {                                                            // ML+0x1da3
            cc("addSprite", FD(0x50) - G32(GS(g_tileStep4c2840)) / 2, FD(0x44) - FD(0x40) / 2 - esi2, FD(0x44), 0x3c, 0x3c, c, 4, 0xb2);   // ML+0x1dd5 addSprite
        }
        c = cc("cellAt", 0x23b, (G32(GS(g_date)) + edi2) % G32((GS(g_sheetCols) + 2284)), 1);  // ML+0x1df5 cellAt
        G32(GS(unk_005a9cc8)) = c;                                                       // ML+0x1e03
        int dv = (esi2 != 0 ? 1 : 0) + 2;                                          // ML+0x1e0f setne, ML+0x1e13
        cc("addSprite", FD(0x50) - G32(GS(g_tileStep4c2840)) / 2, FD(0x44) - FD(0x40) / dv, FD(0x44), 0x3c, 0x3c, c, 4, 0xb2);   // ML+0x1e35 addSprite
    } else {
        // ML+0x1e42
        eax = (eax + eax - 0xd) * G32(GS(f_w_4c2e00)) * G32(GS(g_zoomScale));
        int esi2 = ebp * 7;
        int edi2 = eax / 8;                                                        // ML+0x1e5b..ML+0x1e75
        int c = cc("cellAt", 0x238, (G32(GS(g_date)) + esi2) % G32((GS(g_sheetCols) + 2272)), 1);   // ML+0x1e7e cellAt
        G32(GS(unk_005a9cc8)) = c;                                                       // ML+0x1e8e
        cc("addSprite", FD(0x50) - G32(GS(g_tileStep4c2840)) / 2, FD(0x44) - FD(0x40) / 2 - edi2, FD(0x44), 0x3c, 0x3c, c, 4, 0xb2);   // ML+0x1eb8 addSprite
        c = cc("cellAt", 0x23c, (G32(GS(g_date)) + esi2) % G32((GS(g_sheetCols) + 2288)), 1);  // ML+0x1ed5 cellAt
        G32(GS(unk_005a9cc8)) = c;                                                       // ML+0x1ee1
        cc("addSprite", FD(0x50) - G32(GS(g_tileStep4c2840)) / 2, FD(0x44) - FD(0x40) / 3, FD(0x44), 0x3c, 0x3c, c, 4, 0xb2);   // ML+0x1f1d addSprite
    }
}

// ---- ML+0x12c1..ML+0x1f22: what a type-0x11 tile draws before ML+0x1f25. The rotation switch fills the four
// side masks [F+0x84] [F+0x90] [F+0xb4] [F+0xcc] for rotations 0/2/4/6 only (an odd rotation keeps the values the
// slots already hold); then two word tables at F+0x188 / F+0x198 and the six side-sprite phases. esi = [F+0x14].
void P1_type11(u32 F, int ebp, int ebx, int esi) {
    switch ((u32)G32(GS(g_cameraRot))) {                                                // ML+0x12c9 ja, ML+0x12cf table ML+0x12058
    case 0:                                                                        // ML+0x12d6
        FD(0x84) = 1; FD(0x90) = 4; FD(0xb4) = 0x10; FD(0xcc) = 0x40;
        break;
    case 2:                                                                        // ML+0x1307
        FD(0x84) = 4; FD(0x90) = 0x10; FD(0xb4) = 0x40; FD(0xcc) = 1;
        break;
    case 4:                                                                        // ML+0x1335
        FD(0x84) = 0x10; FD(0x90) = 0x40; FD(0xb4) = 1; FD(0xcc) = 4;
        break;
    case 6:                                                                        // ML+0x1363
        FD(0x84) = 0x40; FD(0x90) = 1; FD(0xb4) = 4; FD(0xcc) = 0x10;
        break;
    default:                                                                       // ML+0x138f: cases 1, 3, 5 and > 6
        break;
    }
    // ML+0x138f
    int edx = G8(GS(g_tileWallMask) + esi);
    int eax = FD(0x90);                                                            // ML+0x1396
    FW(0x198) = 1; FW(0x19a) = 0x13; FW(0x19c) = 0x2c; FW(0x19e) = 0x52;           // ML+0x139d..ML+0x13e5
    FW(0x1a0) = 0x71; FW(0x1a2) = 0x8e; FW(0x1a4) = 0xa1; FW(0x1a6) = 0xae;
    FW(0x188) = 6; FW(0x18a) = 0x20; FW(0x18c) = 0x3f; FW(0x18e) = 0x61;           // ML+0x13ef..ML+0x142b
    FW(0x190) = 0x81; FW(0x192) = 0x9b; FW(0x194) = 0xa7;
    if (eax & edx) P1_t11_4109fb(F, ebp, ebx);                                          // ML+0x13a7 test, ML+0x1435
    P1_t11_410bde(F, ebp, ebx);                                                         // ML+0x161e
    P1_t11_410dd4(F, ebp, ebx);                                                         // ML+0x1814
    u32 pEsi, pEdi;
    P1_t11_410ea4(F, ebp, ebx, &pEsi, &pEdi);                                          // ML+0x18e4
    P1_t11_410ff8(F, ebp, ebx, pEsi, pEdi);                                            // ML+0x1a38
    P1_t11_411282(F, ebp, ebx);                                                        // ML+0x1cc2
}

// ---- ML+0x1fb4..ML+0x226f: type-0x11 tile: a pixel (when Random::range(3) != 0 and zoom >= 4) in one of three
// colours chosen from date and position, a cell 0x233..0x235 when the tile's -1 / -0x32 / +0x32 neighbours are type 0x11 and its +1 neighbour is not,
// and a cell 0x22e..0x232 at the next grid corner when four tiles are type 0x11 and two corner heights match.
// edi = [F+0x14] (ML+0x1f25).
void P1_type11Deco(u32 F, int ebp, int ebx, int edi) {
    int eax = Rnd(3);                                                              // ML+0x1fbb Random::range
    if ((short)eax != 0 && G32(GS(g_zoomScale)) >= 4) {                                 // ML+0x1fc3 (test ax, ax), ML+0x1fcc
        int esi = G32(GS(g_date));                                                 // ML+0x1fce
        int ecx = esi / 2 - ebx * 9 - ebp * 11;                                    // ML+0x1fd4..ML+0x1ff9
        int edx = (esi + ebx * 16 + ebx) % G32(GS(g_tileStep4c2840));                        // ML+0x1fee..ML+0x1ffc
        ecx &= 0x1f;                                                               // ML+0x2006
        edx += FD(0x28);                                                           // ML+0x2002, ML+0x2009
        if (ecx < 5) {                                                             // ML+0x200e jge; ML+0x2013 ja is the same bound
            int col;
            switch (ecx) {                                                         // ML+0x2015 table ML+0x12074
            case 0: case 4: col = (int)0x80004210; break;                          // ML+0x201c
            case 1: case 3: col = (int)0x80006318; break;                          // ML+0x2023
            default: col = (int)0x80007FFF; break;                                 // ML+0x202f (case 2)
            }
            tc("Widget_writePixel", (GS(g_rootWindow) + 628), edx, FD(0x44), col);                        // ML+0x203f Widget_writePixel
        }
    }
    // ML+0x2044
    if (G8(GS(g_tileType) + edi) != 0x11) return;                                      // ML+0x204b -> ML+0x2272
    if (G8((GS(g_courseTable) + 783) + edi) == 0x11 && GU8((GS(g_shotStartDate) + 607) + edi) != 0                 // ML+0x2058, ML+0x2066 (jbe)
        && G8((GS(g_tileType) + 1) + edi) != 0x11 && G8((GS(g_tileType) + 50) + edi) == 0x11            // ML+0x2073, ML+0x2080
        && G8((GS(g_courseTable) + 734) + edi) == 0x11 && (ebx + ebp) % 3 != 0) {                 // ML+0x208d, ML+0x20a0
        int ecx = (ebp + ebx * 2) % 3 + 0x233;                                     // ML+0x20a2..ML+0x20b0
        u8 al = GU8(GS(g_courseType));                                                   // ML+0x20a9
        int k;
        if (al == 2 || al == 3) k = G32(GS(g_cameraRot)) / 2 + 1;                       // ML+0x20b8, ML+0x20bc -> ML+0x20cb
        else k = G32(GS(g_cameraRot)) / 2 - 1;                                          // ML+0x20be
        int c = cc("cellAt", ecx, (G32(GS(g_date)) + ebp * 7) % G32(GS(g_sheetCols) + ecx * 4), k & 3);   // ML+0x20f5 cellAt
        G32(GS(unk_005a9cc8)) = c;                                                       // ML+0x2101
        cc("addSprite", FD(0x50), FD(0x44), FD(0x44), 0x3c, 0x3c, c, 4, 0xb2);      // ML+0x2119 addSprite
    }
    // ML+0x2121
    if (G8(GS(g_tileType) + edi) != 0x11) return;                                      // ML+0x2128
    eax = FD(0x14);                                                                // ML+0x212e
    if (G8((GS(g_tileType) + 50) + eax) != 0x11) return;                                      // ML+0x2139
    if (G8((GS(g_tileType) + 1) + eax) != 0x11) return;                                      // ML+0x2148
    if (G8((GS(g_tileType) + 51) + eax) != 0x11) return;                                      // ML+0x2157
    int esi = ebp + 1;                                                             // ML+0x2161
    edi = ebx + 1;                                                                 // ML+0x2166
    FD(0xc) = esi;                                                                 // ML+0x2169
    int h = cc("cornerHeights", ebp, ebx, 3, 0);                                        // ML+0x216d cornerHeights
    FD(0x18) = h;                                                                  // ML+0x217a
    eax = cc("cornerHeights", esi, edi, 7, 0);                                          // ML+0x217e cornerHeights
    if (FD(0x18) != eax) return;                                                   // ML+0x218c
    // ML+0x2192
    esi = -1;
    u8 cl = GU8(GS(g_tileVariant) + FD(0x14));                                            // ML+0x2199
    if (cl <= 1) {                                                                 // ML+0x21a2 ja
        if ((((ebp - ebx) * 3) & 7) == 0) esi = (ebx + ebp) % 3 + 0x22e;           // ML+0x21ad (test al, 7), ML+0x21bc
        // ML+0x21c2: cmp cl, 1 / ja is never taken here (cl <= 1 tested at ML+0x219f)
        if ((ebx * ebx + ebp * 3) % 13 == 0) esi = (ebx + ebp) % 3 + 0x230;        // ML+0x21dc, ML+0x21eb
    }
    if (esi == -1) return;                                                         // ML+0x21f4
    if (cc("worldToScreen", FD(0xc) << 10, edi << 10, FA(0x208), FA(0x1dc), 0) == 0) return;   // ML+0x2214 worldToScreen, ML+0x221e
    int ecx = (G32(GS(g_cameraRot)) / 2 - ebx + ebp + 1) & 3;                           // ML+0x2220..ML+0x223d
    int c = cc("cellAt", esi, G32(GS(g_date)) % G32(GS(g_sheetCols) + esi * 4), ecx); // ML+0x2243 cellAt
    G32(GS(unk_005a9cc8)) = c;                                                           // ML+0x2256
    cc("addSprite", FD(0x208), FD(0x1dc), FD(0x1dc), 0x3c, 0x3c, c, 4, 0xb2);       // ML+0x226a addSprite
}

// ---- ML+0x2272..ML+0x2352: two neighbour scans whose register results are never read: the first loop's esi / edi
// are overwritten at ML+0x230a / ML+0x231c, the second loop's esi is dead after ML+0x2341 (checked with
// c3fy_firstuse.py). Their frame writes stay: [F+0xc] = 0, [F+0x10] = 9, [F+0x18] = 0 at the end. Then a tile whose
// type is not 1 loses flag 0x80 of its g_tileFlags word. Returns eax and dl as they are at ML+0x2354.
void P1_scan(u32 F, int ebp, int ebx, int* pEax, u8* pDl) {
    int edi = 0;                                                                   // ML+0x2272
    int eax = 1;                                                                   // ML+0x2274
    FD(0xc) = edi;                                                                 // ML+0x2279
    FD(0x10) = eax;                                                                // ML+0x227d
    int esi;
    do {                                                                           // ML+0x2281
        int edx = G32(GS(g_cameraRot)) + eax - 1;                                       // ML+0x2291
        esi = 0;                                                                   // ML+0x2287
        FD(0x18) = 3;                                                              // ML+0x2289
        do {                                                                       // ML+0x2295
            FD(0xc) = FD(0xc) >> 1;                                                // ML+0x2295..ML+0x229b
            eax = edx & 7;
            esi >>= 1;                                                             // ML+0x22a4
            int t = G8(GS(g_tileType) + P1_nb(eax, ebp, ebx));                         // ML+0x22c4
            edi |= (int)(1u << (t & 31));                                          // ML+0x22cc shl eax, cl; ML+0x22d4
            if (G8((GS(g_tileTypeAttrs) + 38) + t * 48) != FD(0x20)) esi |= 4;                     // ML+0x22dd, ML+0x22e1
            edx++;                                                                 // ML+0x22ea
            FD(0x18) = FD(0x18) - 1;                                               // ML+0x22eb
        } while (FD(0x18) != 0);                                                   // ML+0x22f0
        eax = FD(0x10) + 2;                                                        // ML+0x22f2
        FD(0x10) = eax;                                                            // ML+0x22fc
    } while (eax < 8);                                                             // ML+0x2300
    // ML+0x2306
    u8 dl = GU8(GS(g_tileType) + FD(0x14));                                            // ML+0x230e
    esi = FD(0xc);                                                                 // ML+0x230a
    int ecx = 0;                                                                   // ML+0x2314
    do {                                                                           // ML+0x2316
        eax = G32(GS(f_tab_dirDx_4c2878) + ecx) + ebp;
        edi = G32(GS(f_tab_dirDy_4c2898) + ecx);
        esi >>= 1;                                                                 // ML+0x2324
        eax = edi + eax * 50;                                                      // ML+0x2326..ML+0x232c
        if (GU8(GS(g_tileType) + eax + ebx) == dl) esi |= 8;                           // ML+0x2336
        ecx += 8;
    } while (ecx < 0x20);                                                          // ML+0x2341
    if (dl != 1) {                                                                 // ML+0x2346
        eax = FD(0x14);                                                            // ML+0x2348
        GU8(GS(g_tileFlags) + eax * 2) &= 0x7f;                                         // ML+0x234c
    }
    (void)esi;
    (void)edi;
    *pEax = eax;
    *pDl = dl;
}

// ---- ML+0x2739..ML+0x2854: flag-0x20 tile: cell 0x1ff for each of the four even directions whose neighbour
// has flag 0x20 and is not type 0x11, then the cell from the word table F+0x1b8 (variant [F+0x10c + mask]) and, for
// word 0x1fe, cell 0x204 with index date mod [g_sheetCols+0x810].
void P1_flag20Rest(u32 F, int ebp, int ebx) {
    int esi = 0;                                                                   // ML+0x2739
    u32 edi = GS(f_tab_dirDy_4c2898);                                                          // ML+0x273b
    do {                                                                           // ML+0x2740
        int eax = (G32(GS(g_cameraRot)) + esi * 2) & 7;
        int idx = P1_nb(eax, ebp, ebx);                                            // ML+0x2764
        if ((GU8(GS(g_tileFlags) + idx * 2) & 0x20) != 0 && G8(GS(g_tileType) + idx) != 0x11) {   // ML+0x276f, ML+0x2778
            int c = cc("cellAt", 0x1ff, 0, (-1 - esi) & 3);                      // ML+0x278a cellAt
            int ecx = (G32(edi) - 1) * FD(0x40);                                   // ML+0x278f..ML+0x2798
            G32(GS(unk_005a9cc8)) = c;                                                   // ML+0x279f
            cc("enqueueSprite", FD(0x50), FD(0x44), ecx + FD(0x44), 0x3c, 0x3c, c, 4, 0x4e);   // ML+0x27b2 enqueueSprite
        }
        edi += 8;                                                                  // ML+0x27ba
        esi++;
    } while ((int)edi < GS(f_ptrtab_4c28b8));                                               // ML+0x27c4
    int eax = FD(0x18);                                                            // ML+0x27ca
    if (eax == 0) return;                                                          // ML+0x27d0 -> ML+0x2857
    int s = FB(0x10c + eax);                                                       // ML+0x27d6
    int e = FD(0xc);                                                               // ML+0x27de
    int c = cc("cellAt", (int)(short)e, 0, s);                                   // ML+0x27e9 cellAt
    G32(GS(unk_005a9cc8)) = c;                                                           // ML+0x27f6
    cc("enqueueSprite", FD(0x50), FD(0x44), FD(0x44) - FD(0x40), 0x3c, 0x3c, c, 4, 0x4e);   // ML+0x280f enqueueSprite
    if ((short)e != 0x1fe) return;                                                 // ML+0x281c
    c = cc("cellAt", 0x204, G32(GS(g_date)) % G32((GS(g_sheetCols) + 2064)), s);               // ML+0x2831 cellAt
    G32(GS(unk_005a9cc8)) = c;                                                           // ML+0x283a
    cc("addSprite", FD(0x50), FD(0x44), FD(0x44), 0x3c, 0x3c, c, 4, 0x4e);          // ML+0x284f addSprite
}

// ---- ML+0x2399..ML+0x2854: tile with g_tileFlags bit 0x20, [g_tileTypeAttrs+0x22 + 48 * type] > 0, type not 0x15 / 0x16. Builds the
// neighbour mask [F+0x20] (flag 0x20 of the four even neighbours), the 16-word cell table F+0x1b8 and the 16-byte
// variant table F+0x10c; for a tile whose g_tileTypeAttrs+0x26 attribute is 0x11 it draws the cells (0x226 + low 5 flag bits,
// 0x1ff, 0x205 or the table's cell).
void P1_flag20(u32 F, int ebp, int ebx) {
    int edi = G32(GS(g_cameraRot));                                                     // ML+0x2399
    int esi = 0;
    int edx = 6;                                                                   // ML+0x23a1
    do {                                                                           // ML+0x23a6
        int eax = (edx + edi) & 7;
        esi <<= 1;                                                                 // ML+0x23ac
        int idx = P1_nb(eax, ebp, ebx);                                            // ML+0x23c7
        if (GU8(GS(g_tileFlags) + idx * 2) & 0x20) esi |= 1;                            // ML+0x23d1
        edx -= 2;
    } while (edx >= 0);                                                            // ML+0x23d9 jns
    FW(0x1be) = 0x200; FW(0x1c4) = 0x200; FW(0x1ca) = 0x200; FW(0x1d0) = 0x200;   // ML+0x23e5..ML+0x23fd
    edx = FD(0x10);                                                                // ML+0x2405
    FW(0x1ba) = 0x1fe; FW(0x1bc) = 0x1fe; FW(0x1c0) = 0x1fe;                       // ML+0x2409..ML+0x2431
    FW(0x1c2) = 0x1fe; FW(0x1c8) = 0x1fe; FW(0x1cc) = 0x1fe;
    u8 al = GU8((GS(g_tileTypeAttrs) + 38) + edx);                                                 // ML+0x2439
    FD(0x20) = esi;                                                                // ML+0x2446
    FW(0x1b8) = 0;                                                                 // ML+0x244a
    FW(0x1c6) = 0x201; FW(0x1ce) = 0x201; FW(0x1d2) = 0x201; FW(0x1d4) = 0x201;   // ML+0x2454..ML+0x246c
    FW(0x1d6) = 0x202;                                                             // ML+0x2474
    FB(0x10c) = 0; FB(0x10d) = 1; FB(0x10e) = 0; FB(0x10f) = 2;                    // ML+0x247e..ML+0x24f6
    FB(0x110) = 1; FB(0x111) = 1; FB(0x112) = 1; FB(0x113) = 2;
    FB(0x114) = 0; FB(0x115) = 3; FB(0x116) = 0; FB(0x117) = 3;
    FB(0x118) = 0; FB(0x119) = 0; FB(0x11a) = 1; FB(0x11b) = 0;
    if (al != 0x11) return;                                                        // ML+0x2444 cmp, ML+0x24fe -> ML+0x2857
    // ML+0x2504
    edx = G32(GS(g_cameraRot));
    esi = 0;
    edi = 0;
    FD(0x10) = 1;                                                                  // ML+0x250e
    FD(0x18) = 4;                                                                  // ML+0x2516
    do {                                                                           // ML+0x251e
        int eax = edx & 7;
        esi >>= 1;                                                                 // ML+0x2523
        int ecx = P1_t78(eax) + ebp;
        eax = P1_t98(eax) + ebx;
        edi >>= 1;                                                                 // ML+0x2537
        eax = eax + ecx * 50;                                                      // ML+0x2539..ML+0x253f
        if (GU8(GS(g_tileFlags) + eax * 2) & 0x20) {                                    // ML+0x254a
            int t = G8(GS(g_tileType) + eax);                                          // ML+0x254c
            esi |= 8;                                                              // ML+0x2553
            if (G8((GS(g_tileTypeAttrs) + 38) + t * 48) == 0x11) FD(0x10) = 0;                     // ML+0x2563, ML+0x2565
            else edi |= 8;                                                         // ML+0x256f
        }
        edx += 2;                                                                  // ML+0x2576
        FD(0x18) = FD(0x18) - 1;                                                   // ML+0x2579
    } while (FD(0x18) != 0);                                                       // ML+0x257e
    int f10 = FD(0x10);                                                            // ML+0x2580
    FD(0x18) = esi;                                                                // ML+0x2584
    if (f10 != 0) {                                                                // ML+0x258a
        int eax = FD(0xc);                                                         // ML+0x2590
        if ((eax & 0x100) != 0) {                                                  // ML+0x259f (test cx, cx)
            int sel = (FD(0x20) & 5) != 0 ? 1 : 0;                                 // ML+0x25a8..ML+0x25b4 (and dl, 5 / neg / sbb / neg)
            int c = cc("cellAt", (eax & 0x1f) + 0x226, 0, sel);                  // ML+0x25ba cellAt
            G32(GS(unk_005a9cc8)) = c;                                                   // ML+0x25ce
            cc("enqueueSprite", FD(0x50), FD(0x44), FD(0x44) - FD(0x40), 0x28, 0x28, c, 4, 0xa9);   // ML+0x25e3 enqueueSprite
            return;                                                                // ML+0x25e8 -> ML+0x2854
        }
        // ML+0x25ed
        int e5 = FD(0x20) & 5;
        int c = cc("cellAt", 0x1ff, 0, e5 != 0 ? 1 : 0);                         // ML+0x25f9 setne, ML+0x2604 cellAt
        G32(GS(unk_005a9cc8)) = c;                                                       // ML+0x2609
        int z = G32(GS(g_tileStep4c2840));                                                   // ML+0x260e
        int ecx = (e5 != 0) ? -(z / 2) : z / 2;                                    // ML+0x2619 -> ML+0x261b / ML+0x2625
        int hs = FD(0x40) / 2;                                                     // ML+0x262b..ML+0x2640 (esi)
        int y = FD(0x44) - hs;                                                     // ML+0x2645
        cc("enqueueSprite", ecx + FD(0x50), y, y, 0x3c, 0x3c, G32(GS(unk_005a9cc8)), 4, 0x4e);   // ML+0x2654 enqueueSprite
        c = cc("cellAt", 0x1ff, 0, (e5 != 0 ? 1 : 0) + 2);                       // ML+0x265d setne, ML+0x266b cellAt
        z = G32(GS(g_tileStep4c2840));                                                       // ML+0x2672
        G32(GS(unk_005a9cc8)) = c;                                                       // ML+0x267a
        int ax = (e5 != 0) ? -(z / 2) : z / 2;                                     // ML+0x2683 -> ML+0x2685 / ML+0x268d
        cc("enqueueSprite", FD(0x50) - ax, hs + FD(0x44), FD(0x44) - FD(0x40), 0x3c, 0x3c, c, 4, 0x4e);   // ML+0x26b1 enqueueSprite
        return;                                                                    // ML+0x26b9 -> ML+0x2857
    }
    // ML+0x26be: si = word [F+0x1b8 + 2 * esi]; the upper half of esi is the mask's (0 here: esi <= 15)
    esi = (int)(((u32)esi & 0xFFFF0000u) | FUW(0x1b8 + esi * 2));
    int eax = (short)esi;                                                          // ML+0x26c6
    FD(0xc) = esi;                                                                 // ML+0x26ce
    if (eax == 0x1fe) {                                                            // ML+0x26d2
        int k;
        switch ((u32)(edi - 1)) {                                                  // ML+0x26d4 dec, ML+0x26d8 ja, ML+0x26da table ML+0x12088
        case 0: k = 3; break;                                                      // ML+0x26e1
        case 1: k = 2; break;                                                      // ML+0x26e8
        case 3: k = 1; break;                                                      // ML+0x26ef
        case 7: k = 0; break;                                                      // ML+0x26f6
        default:                                                                   // ML+0x2739: cases 2, 4, 5, 6 and > 7
            P1_flag20Rest(F, ebp, ebx);
            return;
        }
        // ML+0x26f8
        int c = cc("cellAt", 0x205, 0, k);                                       // ML+0x2700 cellAt
        G32(GS(unk_005a9cc8)) = c;                                                       // ML+0x270d
        cc("enqueueSprite", FD(0x50), FD(0x44), FD(0x44) - FD(0x40), 0x3c, 0x3c, c, 4, 0x4e);   // ML+0x2726 enqueueSprite
        return;                                                                    // ML+0x272b -> ML+0x2854
    }
    if (eax == -1) return;                                                         // ML+0x2730, ML+0x2733 -> ML+0x2857
    P1_flag20Rest(F, ebp, ebx);                                                    // ML+0x2739
}

// ---- ML+0x2857..ML+0x2954: tile with flag 0x200: for each even direction canStep allows, an enqueued cell
// 0x208 + (g_tileVariant byte mod 7), offset by the direction tables times the zoom; with no allowed direction the
// tile's flag 0x200 is cleared.
void P1_flag200(u32 F, int ebp, int ebx) {
    if ((GU16(GS(g_tileFlags) + FD(0x14) * 2) & 0x200) == 0) return;                    // ML+0x286c -> ML+0x295c
    int esi = 0;                                                                   // ML+0x2872
    int edi = 0;                                                                   // ML+0x2874
    FD(0xc) = edi;                                                                 // ML+0x2876
    do {                                                                           // ML+0x287a
        if (cc("canStep", ebp, ebx, edi) != 0) {                                  // ML+0x287d canStep, ML+0x2887
            esi = (FD(0xc) - G32(GS(g_cameraRot)) + 3) & 7;                             // ML+0x288d..ML+0x28af
            int rem = (int)GU8(GS(g_tileVariant) + FD(0x14)) % 7;                         // ML+0x28a1..ML+0x28ad (edi)
            int edx = (-2 - esi / 2) & 3;                                          // ML+0x28b2..ML+0x28c8
            int c = cc("cellAt", rem + 0x208, 0, edx);                           // ML+0x28cf cellAt
            int ecx = G32(GS(f_tab_dirDy_4c2898) + esi * 4) * G32(GS(g_zoomScale));                 // ML+0x28d4, ML+0x28e1
            G32(GS(unk_005a9cc8)) = c;                                                   // ML+0x28eb
            int y0 = FD(0x44);                                                     // ML+0x28f1
            int y3 = y0 - (ecx * 6) / 2;                                           // ML+0x28f5..ML+0x2903
            int y2 = y0 - (ecx * 5) / 2;                                           // ML+0x2907..ML+0x2914
            int x = FD(0x50) - G32(GS(f_tab_dirDx_4c2878) + esi * 4) * G32(GS(g_zoomScale)) * 4;    // ML+0x290b, ML+0x2916..ML+0x2927
            cc("enqueueSprite", x, y2, y3, 0x28, 0x28, c, 4, rem + 0xaa);               // ML+0x292b enqueueSprite
            edi = FD(0xc);                                                         // ML+0x2930
            esi = 1;                                                               // ML+0x2937
        }
        edi += 2;                                                                  // ML+0x293c
        FD(0xc) = edi;                                                             // ML+0x2942
    } while (edi < 8);                                                             // ML+0x2946
    if (esi == 0) GU8((GS(g_tileFlags) + 1) + FD(0x14) * 2) &= 0xfd;                          // ML+0x294e, ML+0x2954
}

// ---- ML+0x297a..ML+0x2aeb: tile with flag 0x80: with mode [g_panelListMode] == 3 and the selected record
// [g_playerGolfer] (stride 0x100) whose g_golfers+0x21 byte equals the tile's low 5 flag bits, Sprite_draw of g_sprite5423e8
// (only while flag 4 of the date's low byte or flag 4 of g_flags is set); then an enqueued cell 0x185 / 0x189 + [g_courseType].
// edi = [F+0x14], eax = [F+0xc] = flag word & 0x1f.
void P1_flag80(u32 F, int edi, int eax) {
    if (G32(GS(g_panelListMode)) == 3) {                                                    // ML+0x2981
        int ecx = G32(GS(g_playerGolfer));                                                 // ML+0x2983
        if (ecx != -1 && G8((GS(g_golfers) + 33) + (ecx << 8)) == eax                        // ML+0x298c, ML+0x299a
            && ((GU8(GS(g_date)) & 4) != 0 || (GU8(GS(g_flags)) & 4) != 0)) {       // ML+0x29a3, ML+0x29ac
            tc("Sprite_draw", GS(g_sprite5423e8), Root(), G32(GS(g_tileStep4c2840)) + FD(0x28) - 0x14, FD(0x2c) + FD(0x40) - 0xa,
               G32(GS(g_color16Lut)), 0);                                                // ML+0x29de Sprite_draw
        }
    }
    // ML+0x29e3
    u16 cx = GU16(GS(g_tileFlags) + edi * 2);
    eax = 0;                                                                       // ML+0x29eb
    int esi = G8(GS(g_courseType));                                                      // ML+0x29ed
    int ebx = esi + 0x189;                                                         // ML+0x29fc
    if ((cx & 0x4800) == 0x4000) {                                                 // ML+0x2a02, ML+0x2a07
        int edx = FD(0x14);                                                        // ML+0x2a09
        edi = GU8(GS(tile_anim_frame) + edx);                                               // ML+0x2a0f, ML+0x2a15
        ebx = esi + 0x185;                                                         // ML+0x2a17
        esi = G32(GS(g_sheetCols) + ebx * 4);                                           // ML+0x2a1d
        if (edi >= esi) {                                                          // ML+0x2a26 jl
            cx = (u16)(cx & 0xBFFF);                                               // ML+0x2a2c and ch, 0xbf
            edi = esi - 1;                                                         // ML+0x2a2f
            GU16(GS(g_tileFlags) + edx * 2) = cx;                                       // ML+0x2a32
        }
    } else {
        // ML+0x2a3c
        int k = FD(0xc);
        esi = ((k << 6) + k) << 3;                                                 // ML+0x2a42..ML+0x2a4b (k * 0x208)
        int ecx = G32((GS(g_holes) + 36) + esi) / 2 + G32((GS(g_holes) + 32) + esi) + 4;           // ML+0x2a4e..ML+0x2a5f
        int q = ((int)G16((GS(g_holes) + 344) + esi) * 100) / ecx;                          // ML+0x2a63..ML+0x2a76
        edi = G32(GS(g_date)) % G32(GS(g_sheetCols) + ebx * 4);                         // ML+0x2a78..ML+0x2a8a
        eax = cc("clamp", q / 20, 0, 3);                                        // ML+0x2a85..ML+0x2a96 (/ 20), ML+0x2a99 clamp
        if (GU8(GS(g_holes) + esi) == 0) eax = 1;                                   // ML+0x2aa7, ML+0x2aab
    }
    // ML+0x2ab0
    int c = cc("cellAt", ebx, edi, eax);                                         // ML+0x2ab3 cellAt
    int y = FD(0x2c) + FD(0x40);                                                   // ML+0x2ab8..ML+0x2ac5
    G32(GS(unk_005a9cc8)) = c;                                                           // ML+0x2acc
    cc("enqueueSprite", G32(GS(g_tileStep4c2840)) + FD(0x28), y, y, 0x28, 0x28, c, 4, 0x63);      // ML+0x2ade enqueueSprite
}

// ---- ML+0x2aee..ML+0x2d6b: type-0 tile with low flag bits k != 0 (record k * 0x208 of g_holes g_holes): with a
// non-zero g_holes byte, recomputes the tile's g_tileVariant byte from the rotation and the record's g_holes+0x1 /
// g_holes+0x200 fields, draws two cells 0x18d..0x18f mirrored about the tile, and with record flags 1 / 2 an
// enqueued sprite from the records at g_sprites58a538; with a zero byte, clears the tile's g_tileVariant byte.
// eax = [F+0xc], edi = [F+0x14].
void P1_hole(u32 F, int eax, int edi) {
    if (GU8(GS(g_tileType) + edi) != 0) return;                                        // ML+0x2af6 -> ML+0x2d72
    if (eax == 0) return;                                                          // ML+0x2afe
    int esi = ((eax << 6) + eax) << 3;                                             // ML+0x2b04..ML+0x2b0b (eax * 0x208)
    FD(0x18) = esi;                                                                // ML+0x2b0e
    u8 dl = GU8(GS(g_holes) + esi);                                                 // ML+0x2b12
    if (dl == 0) {                                                                 // ML+0x2b1a
        GU8(GS(g_tileVariant) + edi) = 0;                                                 // ML+0x2d6b
        return;
    }
    int ecx = G8((GS(g_holes) + 1) + esi);                                                // ML+0x2b20
    FD(0x2c) = (int)GU8(GS(g_tileVariant) + edi);                                         // ML+0x2b2b, ML+0x2b31
    u8 al = (u8)((u8)(GU8(GS(g_cameraRot)) - (u8)ecx - 2) & 7);                         // ML+0x2b35..ML+0x2b3e
    al = (u8)(al * 3);                                                             // ML+0x2b40 imul bl (bl = 3 at ML+0x2b29)
    int ebx = G32((GS(g_holes) + 512) + esi);                                               // ML+0x2b42
    al = (u8)(al + 1);                                                             // ML+0x2b48
    GU8(GS(g_tileVariant) + edi) = al;                                                    // ML+0x2b4d
    if (ebx & 0x20) {                                                              // ML+0x2b4a, ML+0x2b53
        al = (u8)(al + 1);
        GU8(GS(g_tileVariant) + edi) = al;                                                // ML+0x2b57
    }
    if (ebx & 0x40) GU8(GS(g_tileVariant) + edi) = (u8)(GU8(GS(g_tileVariant) + edi) + 2);       // ML+0x2b60, ML+0x2b62
    if ((int)GU8(GS(g_tileVariant) + edi) != FD(0x2c)) GU8(GS(g_tileWallMask)) &= 0xfd;           // ML+0x2b77, ML+0x2b79 (absolute g_tileWallMask, no tile index)
    // ML+0x2b80
    ebx = ((ecx - G32(GS(g_cameraRot))) + 1) & 7;                                       // ML+0x2b80..ML+0x2b90
    int a = cc("clamp", (int)(s8)dl - 3, 0, 2);                                 // ML+0x2b99 clamp
    int edi2 = G32((GS(g_sheetCols) + 1588) + a * 4) - 1;                                        // ML+0x2ba2, ML+0x2bb9
    a += 0x18d;                                                                    // ML+0x2ba9
    u16 si = GU16(GS(g_tileFlags) + FD(0x14) * 2);                                      // ML+0x2bb1
    int ecx2 = edi2;                                                               // ML+0x2bbc
    if ((si & 0x4800) == 0x4000) {                                                 // ML+0x2bbe, ML+0x2bc9
        ecx2 = GU8(GS(tile_anim_frame) + FD(0x14));                                         // ML+0x2bd1
        if (ecx2 >= G32(GS(g_sheetCols) + a * 4)) {                                     // ML+0x2be0 jl
            si = (u16)(si & 0xBFFF);                                               // ML+0x2be6
            ecx2 = edi2;                                                           // ML+0x2bec
            GU16(GS(g_tileFlags) + FD(0x14) * 2) = si;                                  // ML+0x2bee
        }
    }
    // ML+0x2bf6
    int c = cc("cellAt", a, ecx2, 0);                                            // ML+0x2bfa cellAt
    u32 pB = GS(f_tab_dirDy_4c2898) + ebx * 4;                                                 // ML+0x2c02 (esi)
    G32(GS(unk_005a9cc8)) = c;                                                           // ML+0x2c13
    u32 pA = GS(f_tab_dirDx_4c2878) + ebx * 4;                                                 // ML+0x2c18 (ebx)
    int x2, y2, c2;
    if (ebx & 1) {                                                                 // ML+0x2c09 test bl, 1; ML+0x2c21
        int dy = G32(pB) * G32(GS(g_sprite58b384));                                        // ML+0x2c23..ML+0x2c2a
        int dx = G32(GS(g_sprite58b384)) * G32(pA);                                        // ML+0x2c2d
        cc("addSprite", FD(0x50) + dx * 4, FD(0x44) + dy * 2, FD(0x44), 0x28, 0x28, c, 4, 0x5e);   // ML+0x2c41 addSprite
        dy = G32(pB) * G32(GS(g_sprite58b384));                                            // ML+0x2c46..ML+0x2c53
        dx = G32(GS(g_sprite58b384)) * G32(pA);                                            // ML+0x2c56
        c2 = G32(GS(unk_005a9cc8));                                                      // ML+0x2c4d
        y2 = FD(0x44) - dy * 2;                                                    // ML+0x2c66..ML+0x2c69
        x2 = FD(0x50) - dx * 4;                                                    // ML+0x2c6c..ML+0x2c76
    } else {
        // ML+0x2c7b
        int dy = G32(pB) * G32(GS(g_sprite58b384));                                        // ML+0x2c7b..ML+0x2c83
        int dx = G32(GS(g_sprite58b384)) * G32(pA);                                        // ML+0x2c86
        int yy = FD(0x44) + dy * 2 + dy;                                           // ML+0x2c89..ML+0x2c91
        int xx = FD(0x50) + dx * 4 + dx;                                           // ML+0x2c94..ML+0x2c9d
        cc("addSprite", xx, yy, FD(0x44), 0x28, 0x28, c, 4, 0x5e);                  // ML+0x2ca0 addSprite
        c2 = G32(GS(unk_005a9cc8));                                                      // ML+0x2ca5
        int z = G32(GS(g_sprite58b384));                                                   // ML+0x2caa
        dy = G32(pB) * z;                                                          // ML+0x2cb5, ML+0x2cb7
        dx = z * G32(pA);                                                          // ML+0x2cba
        y2 = FD(0x44) - dy * 3;                                                    // ML+0x2cbd..ML+0x2cc9
        x2 = FD(0x50) - dx * 5;                                                    // ML+0x2ccc..ML+0x2cd6
    }
    cc("addSprite", x2, y2, FD(0x44), 0x28, 0x28, c2, 4, 0x5e);                     // ML+0x2cd9 addSprite (both arms)
    // ML+0x2cde
    esi = FD(0x18);
    int edx = FD(0xc);                                                             // ML+0x2ce2
    int fl = G32((GS(g_holes) + 512) + esi);                                                // ML+0x2ce9
    ecx = edx - 1;                                                                 // ML+0x2cef
    if (fl & 1) ecx = edx + 0x11;                                                  // ML+0x2cf4, ML+0x2cf6
    if (fl & 2) ecx = edx + 0x23;                                                  // ML+0x2cfb, ML+0x2cfd
    if ((fl & 3) == 0) return;                                                     // ML+0x2d02 -> ML+0x2d72
    int bit = ((int)GU8((GS(g_holes) + 1) + esi) - G32(GS(g_cameraRot))) & 4;                  // ML+0x2d04..ML+0x2d12 (low byte of the difference)
    int z = G32(GS(g_sprite58b384));                                                       // ML+0x2d14
    int yy;
    if (bit != 0) yy = FD(0x44) - z * 3;                                           // ML+0x2d19, ML+0x2d1b..ML+0x2d22
    else yy = z + FD(0x44) + z * 2;                                                // ML+0x2d5f..ML+0x2d66
    // ML+0x2d24
    cc("enqueueSprite", FD(0x50), yy, yy, 9, (ecx / 18) * 3 + 0x10, GS(g_sprites58a538) + ecx * 11 * 4, 4, -1);   // ML+0x2d55 enqueueSprite
}

// ---- ML+0x1046..ML+0x2d6b: one tile (ebp, ebx) of the per-tile loop; returning = ML+0x2d72.
void P1_tile(u32 F, int ebp, int ebx) {
    FD(0x14) = ebx + ebp * 50;                                                     // ML+0x1046..ML+0x105c
    if (cc("tileToScreen", ebp, ebx, FA(0x50), FA(0x44)) == 0) return;                 // ML+0x1060 tileToScreen, ML+0x106a
    FD(0x28) = FD(0x50) - G32(GS(g_tileStep4c2840));                                         // ML+0x1070..ML+0x1080
    FD(0x2c) = FD(0x44) - FD(0x40);                                                // ML+0x1084..ML+0x108a
    P1_grid(F, ebp, ebx);                                                          // ML+0x108e
    // ML+0x1201: tile type 0x14 draws nothing
    int esi = FD(0x14);
    int t = G8(GS(g_tileType) + esi);                                                  // ML+0x1205
    if (t == 0x14) return;                                                         // ML+0x120d
    FD(0x20) = G8((GS(g_tileTypeAttrs) + 38) + t * 0x30);                                          // ML+0x1213..ML+0x1234
    tc("setDrawTarget", Root(), GS(g_fontRef_519fd8), 0, 0, 0);                                   // ML+0x1238 setDrawTarget
    if ((GU8(GS(g_flags)) & 0x20) != 0) {                                           // ML+0x1244
        int v = G8(GS(g_tileWallMask) + esi);                                              // ML+0x1246
        if (v != 0) {                                                              // ML+0x124e
            GU8(kBuf) = 0;                                                         // ML+0x125b
            int r = Itoa(v, GS(g_textBuf), 10);                                       // ML+0x1262 __itoa
            StrCat(kBuf, (u32)r);                                                  // ML+0x1267..ML+0x129b
            cc("drawCenteredText", (int)kBuf, FD(0x50), FD(0x44) - 4, (int)0x80007FFF);    // ML+0x12a8 drawCenteredText
            esi = FD(0x14);                                                        // ML+0x12ad
        }
    }
    if (G8(GS(g_tileType) + esi) == 0x11) P1_type11(F, ebp, ebx, esi);                 // ML+0x12b4, ML+0x12bb
    // ML+0x1f25: type 0xb on course type 3 without flag 0x100: enqueued cell 0x12a
    int edi = FD(0x14);
    if (G8(GS(g_tileType) + edi) == 0xb && G8(GS(g_courseType)) == 3                         // ML+0x1f30, ML+0x1f39
        && (GU16(GS(g_tileFlags) + edi * 2) & 0x100) == 0) {                            // ML+0x1f3b..ML+0x1f4c
        int c = cc("cellAt", 0x12a, 0, (G32(GS(g_cameraRot)) / 2 - ebx * 2 + ebp) & 3);   // ML+0x1f6a cellAt
        G32(GS(unk_005a9cc8)) = c;                                                       // ML+0x1f85
        int k = ((ebx + ebp) % 3 != 0) ? 3 : 4;                                    // ML+0x1f7f idiv, ML+0x1f8b..ML+0x1f8f
        cc("enqueueSprite", FD(0x50), FD(0x44), FD(0x44), 0x28, 0x26, c, k, 0xa3);      // ML+0x1f9f enqueueSprite
    }
    if (G8(GS(g_tileType) + edi) == 0x11) P1_type11Deco(F, ebp, ebx, edi);             // ML+0x1fa7, ML+0x1fae
    // ML+0x2272
    int eax;
    u8 dl;
    P1_scan(F, ebp, ebx, &eax, &dl);
    // ML+0x2354: [F+0xc] = flag word (upper half of eax kept: mov ax, word)
    eax = (int)(((u32)eax & 0xFFFF0000u) | GU16(GS(g_tileFlags) + FD(0x14) * 2));      // ML+0x2354, ML+0x2358
    FD(0xc) = eax;                                                                 // ML+0x2362
    if ((eax & 0x20) != 0) {                                                       // ML+0x2360 test al, 0x20; ML+0x2366
        int a48 = (int)(s8)dl * 48;                                                // ML+0x236c..ML+0x2372
        FD(0x10) = a48;                                                            // ML+0x2375
        if (G8((GS(g_tileTypeAttrs) + 34) + a48) > 0 && dl != 0x16 && dl != 0x15) {                // ML+0x2381 jle, ML+0x238a, ML+0x2393
            P1_flag20(F, ebp, ebx);                                                // ML+0x2399
            P1_flag200(F, ebp, ebx);                                               // ML+0x2857
        }
    }
    // ML+0x295c
    edi = FD(0x14);
    u16 cx = GU16(GS(g_tileFlags) + edi * 2);                                           // ML+0x2960
    eax = cx & 0x1f;                                                               // ML+0x2968, ML+0x296a
    FD(0xc) = eax;                                                                 // ML+0x2970
    if ((cx & 0x80) != 0) {                                                        // ML+0x296d test cl, 0x80; ML+0x2974
        P1_flag80(F, edi, eax);                                                    // ML+0x297a
        eax = FD(0xc);                                                             // ML+0x2ae3
        edi = FD(0x14);                                                            // ML+0x2ae7
    }
    P1_hole(F, eax, edi);                                                          // ML+0x2aee
}

// ---- ML+0x1044..ML+0x2d8e: the per-tile loop. Outer counter ebx (kept in [F+0x30]), inner counter ebp, both
// 0..49; the tile body can clobber ebx (ML+0x29fc onward), so it is reloaded from [F+0x30] after each tile.
void Ph_00410604(u32 F) {
    int ebx = 0;                                                                   // ML+0x103a (entry)
    do {
        int ebp = 0;                                                               // ML+0x1044
        do {
            P1_tile(F, ebp, ebx);                                                  // ML+0x1046
            ebx = FD(0x30);                                                        // ML+0x2d72
            ebp++;                                                                 // ML+0x2d76
        } while (ebp < 0x32);                                                      // ML+0x2d7a
        ebx++;                                                                     // ML+0x2d80
        FD(0x30) = ebx;                                                            // ML+0x2d84
    } while (ebx < 0x32);                                                          // ML+0x2d88
}

// c3fy part P2: mainLoop ML+0x0, range ML+0x2d8e..ML+0x3f7d (the second per-tile pass).
// Hand transcription of log/c3/alt/c3fy_norm.asm. Every [F+X] access of the original is a frame access at the same
// offset and width; every callee is called at its original address (CC cdecl, TC thiscall).
// Loop: b = [F+0x30] (esi) outer 0..49, a = [F+0x20] (ebp) inner 0..49, tile index idx = a * 50 + b ([F+0x14]).

// cellAt cellAt (cdecl, 3 arguments) followed by the store of its result into [unk_005a9cc8], the order every
// cellAt site of this range has (no call between the two)
int P2_cell(int t, int f, int r) {
    int c = cc("cellAt", t, f, r);
    G32(GS(unk_005a9cc8)) = c;
    return c;
}
// enqueueSprite enqueueSprite (cdecl, 8 arguments) with the arguments ([F+0x3c], [F+0x38], [F+0x38], w, h, cell, 4, k)
void P2_enq(u32 F, int w, int h, int cell, int k) {
    cc("enqueueSprite", FD(0x3c), FD(0x38), FD(0x38), w, h, cell, 4, k);
}
// addSprite addSprite (cdecl, 8 arguments) with the same argument shape; its return value is never read here
void P2_add(u32 F, int w, int h, int cell, int k) {
    cc("addSprite", FD(0x3c), FD(0x38), FD(0x38), w, h, cell, 4, k);
}

// ML+0x2dfd..ML+0x2eab: when bit 0x20 of the byte [g_flags] is set, three filled rectangles on the window object
// g_rootWindow (fillWindowRect fillWindowRect, thiscall, 5 arguments) whose heights come from the per-tile byte tables
// g_ballStopCount, g_tileMoodUp (x2) and g_tileMoodDown (x2), width [g_tileStep4c2840] / 4, at the tile's screen point ([F+0x3c], [F+0x38]).
void P2_bars(u32 F, int idx) {
    if (!(GU8(GS(g_flags)) & 0x20)) return;   // ML+0x2dfd / ML+0x2e04
    {
        int q = G32(GS(g_tileStep4c2840)) / 4;          // ML+0x2e0a..ML+0x2e27 (cdq; and edx, 3; add; sar 2)
        int h = GU8(GS(g_ballStopCount) + idx);        // ML+0x2e11
        tc("fillWindowRect", GS(g_rootWindow), q + FD(0x3c), FD(0x38) - h, q, h, (int)0x80000210);   // ML+0x2e3a fillWindowRect
    }
    {
        int q = G32(GS(g_tileStep4c2840)) / 4;          // ML+0x2e3f..ML+0x2e64
        int h2 = GU8(GS(g_tileMoodUp) + idx) << 1;  // ML+0x2e46 / ML+0x2e5b
        tc("fillWindowRect", GS(g_rootWindow), FD(0x3c) - q, FD(0x38) - h2, q, h2, (int)0x800023E8);   // ML+0x2e71 fillWindowRect
    }
    {
        int q = G32(GS(g_tileStep4c2840)) / 4;          // ML+0x2e76..ML+0x2e94
        int h2 = GU8(GS(g_tileMoodDown) + idx) << 1;  // ML+0x2e7d / ML+0x2e92
        tc("fillWindowRect", GS(g_rootWindow), FD(0x3c), FD(0x38) - h2, q, h2, (int)0x80007D08);   // ML+0x2ea6 fillWindowRect
    }
}

// ML+0x2eab..ML+0x308f: clears the text buffer; when bit 0x2000 of the tile word is set, selects the draw target
// (g_font51b360 when [g_zoomScale] >= 4, else g_fontRef_519fd8), builds a label in the text buffer from the tile type byte
// [g_tileType + idx] (switch table ML+0x120a8 on type - 12) and draws it centred (drawCenteredText2 drawCenteredText2) at
// ([F+0x3c], [F+0x38] - 3) on one tile of every 8 in a date-dependent pattern.
// Returns the value ecx holds at ML+0x308f (its upper 16 bits reach [F+0xc] at ML+0x3099; see the notes).
u32 P2_label(u32 F, int a, int idx) {
    u16 w = GU16(GS(g_tileFlags) + 2 * idx);       // ML+0x2eab
    GU8(kBuf) = 0;                             // ML+0x2eb3
    u32 ecx = w & 0x2000;                      // ML+0x2eba
    if (ecx == 0) return ecx;                  // ML+0x2ec0 / ML+0x2ec3 -> ML+0x308f
    u32 tgt = GS(g_font51b360);                      // ML+0x2ed1
    if (G32(GS(g_zoomScale)) < 4) tgt = GS(g_fontRef_519fd8); // ML+0x2ece / ML+0x2ed6 / ML+0x2ed8
    int root = Root();                         // ML+0x2edd
    tc("setDrawTarget", root, (int)tgt, 0, 0, 0);   // ML+0x2eea setDrawTarget
    ecx = (u32)root;                           // the original setDrawTarget (setDrawTarget..setDrawTarget+0x31) never writes ecx
    int sel = G8(GS(g_tileType) + idx) - 0xc;      // ML+0x2eef / ML+0x2ef6
    u32 cat = 0;                               // edi at ML+0x300a, the strcat source
    bool doCat = true;
    switch ((u32)sel) {                        // ML+0x2ef9 ja ML+0x3032; ML+0x2f02 jmp [table ML+0x120a8]
    case 5:                                    // type 17 -> ML+0x2f09
        StrCpy(kBuf, (GS(f_strpool_4c6980) + 80));              // ML+0x2f09..ML+0x2f37
        cat = FU(0x238 + 4 * ((FD(0x30) + a) % 16));   // ML+0x2f19 / ML+0x2f26 / ML+0x2f32..ML+0x2f40
        break;                                 // ML+0x2f47 -> ML+0x300a
    case 6:                                    // type 18 -> ML+0x2f4c
        StrCpy(kBuf, FU(0x238 + 4 * ((FD(0x30) + a) % 16)));   // ML+0x2f4c..ML+0x2f83
        cat = (GS(f_strpool_4c6980) + 68);                      // ML+0x2f85
        break;                                 // ML+0x2f8a -> ML+0x300a
    case 0:                                    // type 12 -> ML+0x2f8c
        StrCpy(kBuf, FU(0x218 + 4 * ((FD(0x30) + a) % 8)));    // ML+0x2f8c..ML+0x2fc3
        cat = (GS(f_strpool_4c6980) + 60);                      // ML+0x2fc5
        break;                                 // ML+0x2fca -> ML+0x300a
    case 1:
    case 2:
    case 3:                                    // types 13..15 -> ML+0x2fcc
        StrCpy(kBuf, FU(0x218 + 4 * ((FD(0x30) + a) % 8)));    // ML+0x2fcc..ML+0x3003
        cat = (GS(f_strpool_4c6980) + 52);                      // ML+0x3005, falls into ML+0x300a
        break;
    default:                                   // type 16 (entry 4) and type - 12 > 6 unsigned -> ML+0x3032
        doCat = false;
        break;
    }
    if (doCat) {
        StrCat(kBuf, cat);                     // ML+0x300a..ML+0x3030
        ecx = 0;                               // rep movsb at ML+0x3030 ends with ecx = 0
    }
    if (GU8(kBuf) == 0) return ecx;            // ML+0x3032 / ML+0x3039 -> ML+0x308f
    int b = FD(0x30);                          // ML+0x303b
    ecx = (u32)(b + a);                        // ML+0x3048
    int d = (G32(GS(g_date)) >> 5) + (b + a) + 2 * b;   // ML+0x303f..ML+0x304e
    if (d & 7) return ecx;                     // ML+0x3050 test dl, 7 / ML+0x3053
    if (GU8(GS(g_preferences)) & 1) return ecx;       // ML+0x3055 / ML+0x305c
    if (G32(GS(g_zoomScale)) <= 2) return ecx;      // ML+0x305e / ML+0x3065
    if (G32(GS(g_panelListMode)) == 3) return ecx;      // ML+0x3067 / ML+0x306e
    cc("drawCenteredText2", (int)kBuf, FD(0x3c), FD(0x38) - 3, (int)0x80007FFF);   // ML+0x3087 drawCenteredText2
    return 0;   // ecx as drawCenteredText2 leaves it: not determined (notes, UNCERTAIN 1)
}

// ML+0x308f..ML+0x33e4: [F+0xc] = ecx with the tile word in its low half. When bit 0x1000 of the tile word is set:
// a 4-bit mask of the four neighbours (offset tables f_tab_dirDx_4c2878 / f_tab_dirDy_4c2898) that also have bit 0x1000, the same
// [g_tileVariant] / 5 and the same [g_tileLevel] byte, rotated right [g_cameraRot] / 2 times within 4 bits; it selects a
// sprite type (word table g_maskSpriteTable) and rotation (g_maskSpriteTable+0x2), the type is moved by 12 or 6 for [g_tileVariant] >= 10 or
// >= 5, the frame is the type's last frame (count table g_sheetCols) or [F+0x10]; cellAt + addSprite at the tile's point.
// For every fifth tile ((b + 2a) % 5 == 0) whose mask has bits 0 and 3, whose (a-1, b-1) tile has bit 0x1000 and whose
// heightBlend at (a-1, b-1) equals the one at (a, b): a second sprite (type 0x1b4 + (a & 1)) enqueued at one of four
// offsets selected by [g_cameraRot] (switch table ML+0x120c4). Every path through the bit-0x1000 block then clears bit
// 0x100 of the tile word (ML+0x33dc).
void P2_paths(u32 F, int idx, u32 ecx) {
    u16 w = GU16(GS(g_tileFlags) + 2 * idx);       // ML+0x308f (mov cx, word)
    ecx = (ecx & 0xFFFF0000u) | w;
    FU(0xc) = ecx;                             // ML+0x3099
    if (!(w & 0x1000)) return;                 // ML+0x309d..ML+0x30a5 -> ML+0x33e4
    int ti = FD(0x14);                         // edx ML+0x30ab
    int h = GU8(GS(g_tileVariant) + ti);              // ebx ML+0x30af / ML+0x30bc
    u32 c800 = ecx & 0x800;                    // ML+0x30b6
    int mask = 0;                              // ebp ML+0x30c2
    FU(0x18) = c800;                           // ML+0x30c6
    FD(0x2c) = h % 5 + 0x2d;                   // ML+0x30ca..ML+0x30d3
    if ((u16)c800 != 0) FD(0x2c) = 0xbb;       // ML+0x30d0 / ML+0x30d7 / ML+0x30d9
    for (int i = 0; i < 0x20; i += 8) {        // ML+0x30e1 edi = 0; ML+0x3161..ML+0x3167
        int ni = (G32(GS(f_tab_dirDx_4c2878) + i) + FD(0x20)) * 50 + G32(GS(f_tab_dirDy_4c2898) + i) + FD(0x30);   // ML+0x30e3..ML+0x3104
        mask >>= 1;                            // ML+0x30f5
        if ((GU16(GS(g_tileFlags) + 2 * ni) & 0x1000) != 0x1000) continue;   // ML+0x3107..ML+0x311a
        int nq = GU8(GS(g_tileVariant) + ni) / 5;     // ML+0x311c..ML+0x3139
        if (h / 5 != nq) continue;             // ML+0x313b..ML+0x3148
        int tj = FD(0x14);                     // ML+0x314a
        if (GU8(GS(g_tileLevel) + tj) == GU8(GS(g_tileLevel) + ni)) mask |= 8;   // ML+0x314e..ML+0x315e
    }
    int r = G32(GS(g_cameraRot)) / 2;               // ML+0x316d..ML+0x3175
    if (r > 0) {                               // ML+0x3177 / ML+0x3179
        do {
            int lo = (mask & 1) << 3;          // ML+0x317b..ML+0x3180
            mask >>= 1;                        // ML+0x3183
            mask |= lo;                        // ML+0x3185
        } while (--r != 0);                    // ML+0x3187 / ML+0x3188
    }
    int t = G16(GS(g_maskSpriteTable) + 4 * mask);        // ecx ML+0x318a
    int rot = G16((GS(g_maskSpriteTable) + 2) + 4 * mask);      // eax ML+0x3192
    if (t == 0x1a3) rot ^= 2;                  // ML+0x319a / ML+0x31a2
    if (t == 0x1a5) rot = (rot + 1) & 3;       // ML+0x31a5 / ML+0x31ad / ML+0x31ae
    if (rot == -1) rot = (FD(0x20) - 2 * FD(0x30)) & 3;   // ML+0x31b1..ML+0x31c5
    if (h >= 0xa) t += 0xc;                    // ML+0x31c8 / ML+0x31cd
    else if (h >= 5) t += 6;                   // ML+0x31d2 / ML+0x31d7
    int last = G32(GS(g_sheetCols) + 4 * t) - 1;    // edi ML+0x31da / ML+0x31e5
    int f10 = FD(0x10);                        // ML+0x31e1
    int frame = last;                          // esi ML+0x31e9
    if (f10 != -1 && FW(0x18) == 0) {          // ML+0x31e6 / ML+0x31eb / ML+0x31ed / ML+0x31f3
        int tj = FD(0x14);                     // ebx ML+0x31f5
        frame = f10;                           // ML+0x31f9
        if ((int)GU8(GS(tile_anim_frame) + tj) >= last) {   // ML+0x31fb..ML+0x3205
            GU16(GS(g_tileFlags) + 2 * tj) = (u16)(FU(0xc) & 0xFFFFBFFFu);   // ML+0x3207..ML+0x3210
            GU8(GS(tile_anim_frame) + tj) = 0xff;       // ML+0x3218
        }
    }
    int cell = cc("cellAt", t, frame, rot);  // ML+0x3222 cellAt
    int k2c = FD(0x2c);                        // ML+0x3227
    G32(GS(unk_005a9cc8)) = cell;                    // ML+0x3232
    cc("addSprite", FD(0x3c), FD(0x38), FD(0x38), 0x2a, 0x2a, cell, 4, k2c);   // ML+0x3243 addSprite
    int bb = FD(0x30);                         // ebx ML+0x3248
    int aa = FD(0x20);                         // esi ML+0x324c
    int tk = FD(0x14);                         // ebp at ML+0x33dc (read at ML+0x3274 or ML+0x33d8)
    if ((bb + aa * 2) % 5 == 0 && (u8)(mask & 9) == 9) {   // ML+0x3258..ML+0x326e
        if ((GU16((GS(g_sprites53c570) + 1306) + 2 * tk) & 0x1000) == 0x1000) {   // ML+0x3274..ML+0x3289 (tile idx - 51)
            int hb1 = cc("heightBlend", aa - 1, bb - 1, 0);   // ML+0x3299 heightBlend
            int hb2 = cc("heightBlend", aa, bb, 0);           // ML+0x32a4 heightBlend
            if (hb2 == hb1) {                  // ML+0x32ac / ML+0x32ae
                int odd = aa & 1;              // ML+0x32b4 / ML+0x32b6
                int t2 = odd + 0x1b4;          // ecx ML+0x32b9
                int k = (odd != 0 ? 0x26 : 0) + 0x96;   // esi ML+0x32bf..ML+0x32cb
                int f = FD(0x10);              // ML+0x32cd
                int fr2, rot2;
                int cnt = 0;
                if (f != -1 && f < (cnt = G32(GS(g_sheetCols) + 4 * t2)) &&
                    (GU16(GS(g_tileFlags) + 2 * tk) & 0x800) == 0) {   // ML+0x32d1..ML+0x32f1
                    rot2 = (G32(GS(g_cameraRot)) / 2 + bb) & 3;          // ML+0x32f3..ML+0x32ff
                    fr2 = FD(0x10) % cnt;                           // ML+0x3303..ML+0x3308
                } else {                                            // ML+0x330c
                    rot2 = (G32(GS(g_cameraRot)) / 2 + bb) & 3;          // ML+0x330c..ML+0x331f
                    fr2 = G32(GS(g_sheetCols) + 4 * t2) - 1;             // ML+0x3314 / ML+0x3322
                }
                int c2 = cc("cellAt", t2, fr2, rot2);   // ML+0x3326 cellAt
                u32 sw = GU32(GS(g_cameraRot));     // ML+0x332b
                G32(GS(unk_005a9cc8)) = c2;          // ML+0x3337
                switch (sw) {                  // ML+0x3334 ja ML+0x33dc; ML+0x3342 jmp [table ML+0x120c4]
                case 0:                        // -> ML+0x3349
                    cc("enqueueSprite", FD(0x3c) - G32(GS(g_tileStep4c2840)), FD(0x38), FD(0x38), 0x50, 0x4c, c2, 4, k);   // ML+0x3364 enqueueSprite
                    break;
                case 2:                        // -> ML+0x336e
                    cc("enqueueSprite", FD(0x3c), FD(0x40) + FD(0x38), FD(0x38), 0x50, 0x4c, c2, 4, k);   // ML+0x3387 enqueueSprite
                    break;
                case 4:                        // -> ML+0x3391
                    cc("enqueueSprite", G32(GS(g_tileStep4c2840)) + FD(0x3c), FD(0x38), FD(0x38), 0x50, 0x4c, c2, 4, k);   // ML+0x33ab enqueueSprite
                    break;
                case 6:                        // -> ML+0x33b5
                    cc("enqueueSprite", FD(0x3c), FD(0x38) - FD(0x40), FD(0x38), 0x50, 0x4c, c2, 4, k);   // ML+0x33ce enqueueSprite
                    break;
                default:                       // 1, 3, 5 and > 6 -> ML+0x33dc
                    break;
                }
            }
        }
    }
    GU8((GS(g_tileFlags) + 1) + 2 * tk) &= 0xfe;          // ML+0x33dc (clears bit 0x100 of the tile word)
}

// ML+0x33e4..ML+0x3b5c: when bit 0x100 of the tile word is set: draw target g_fontRef_519fd8, a scenery label
// (sceneryLabel sceneryLabel into the text buffer, drawn centred at ([F+0x3c], [F+0x38] + 5)) under the same three global
// gates as the type label, then one or two sprites chosen by the class byte [g_tileTypeAttrs+0x26 + 48 * type] (switch on
// class - 4 through the byte table ML+0x12100 and the jump table ML+0x120e0), with rotation
// ([g_cameraRot] / 2 - 2b + a) & 3 unless the case computes its own.
void P2_scenery(u32 F) {
    int ti = FD(0x14);                         // edi ML+0x33e4
    int aa = FD(0x20);                         // ebx ML+0x33e8
    if (!(GU16(GS(g_tileFlags) + 2 * ti) & 0x100)) return;   // ML+0x33ec..ML+0x33fc -> ML+0x3b5c
    tc("setDrawTarget", Root(), GS(g_fontRef_519fd8), 0, 0, 0);   // ML+0x3413 setDrawTarget
    if (!(GU8(GS(g_preferences)) & 1) && G32(GS(g_zoomScale)) > 2 && G32(GS(g_panelListMode)) != 3) {   // ML+0x3418..ML+0x3431
        int b0 = FD(0x30);                     // ML+0x3433
        GU8(kBuf) = 0;                         // ML+0x343b
        if (cc("sceneryLabel", aa, b0, 1) != 0)    // ML+0x3442 sceneryLabel / ML+0x344c
            cc("drawCenteredText2", (int)kBuf, FD(0x3c), FD(0x38) + 5, (int)0x80007FFF);   // ML+0x3465 drawCenteredText2
    }
    int twob = FD(0x30) * 2;                   // ebp ML+0x3472 / ML+0x3477
    s8 ty = G8(GS(g_tileType) + ti);               // cl ML+0x347a
    u8 ty8 = (u8)ty;
    int rot = ((G32(GS(g_cameraRot)) / 2) - twob + aa) & 3;   // esi ML+0x346d..ML+0x349d
    int cls = G8((GS(g_tileTypeAttrs) + 38) + 48 * (int)ty) - 4;        // ML+0x3484..ML+0x349a
    int c;
    // ML+0x34a0 ja ML+0x3afd; ML+0x34ab byte table ML+0x12100[cls] -> ML+0x34b1 jmp [ML+0x120e0 + 4 * that]
    switch ((u32)cls) {
    case 14:
    case 15:                                   // classes 18, 19: byte 5 -> ML+0x34b8
        if (GU8(GS(g_courseType)) == 1) break;       // ML+0x34b8 / ML+0x34bf
        c = P2_cell(0x12c, 0, rot);            // ML+0x34cd cellAt / ML+0x34d2
        P2_enq(F, 0x28, 0x28, c, 0xa5);        // ML+0x34ee enqueueSprite (tail ML+0x34d7..ML+0x34f3)
        break;
    case 13: {                                 // class 17: byte 4 -> ML+0x34fb
        int tj = FD(0x14);                     // ML+0x34fb
        if (GU8(GS(g_tileFlags) + 2 * tj) & 0x20) break;   // ML+0x34ff / ML+0x3507
        if (ty8 == 0x12) break;                // ML+0x350d / ML+0x3510
        u8 hh = GU8(GS(g_tileVariant) + tj);          // dl ML+0x3516
        if (hh != 0 && ty8 == 0x11) {          // ML+0x3518 / ML+0x351e / ML+0x3520 / ML+0x3523
            int b0 = FD(0x30);                 // esi ML+0x3525
            int v = (G32(GS(g_date)) + b0 * 7) + aa * 3;   // eax ML+0x3529..ML+0x353d
            int m = v % 64;                    // ecx ML+0x353f..ML+0x354d
            int lim = G32((GS(g_sheetCols) + 1660));         // ML+0x354e
            if (m >= lim) break;               // ML+0x3554 / ML+0x3556 -> ML+0x3b5c
            int r2 = ((v >> 6) + b0 + aa) & 3; // ML+0x355c..ML+0x3563
            int cl = cc("clamp", m, 0, lim - 1);   // ML+0x356c clamp
            c = P2_cell(0x19f, cl, r2);        // ML+0x357a cellAt / ML+0x3586
            P2_enq(F, 0x3c, 0x3c, c, 0x5a);    // ML+0x34ee enqueueSprite (tail ML+0x34e3)
            break;
        }
        if (GU8(GS(g_courseType)) == 1) {            // ML+0x3592 / ML+0x3599
            c = P2_cell(0x129, 0, rot);        // ML+0x35a3 cellAt / ML+0x35a8
            P2_enq(F, 0x28, 0x28, c, 0xa2);    // ML+0x3913 enqueueSprite (tail ML+0x3901)
        } else {
            int fr = G32(GS(g_date)) % G32((GS(g_sheetCols) + 1664));   // ML+0x35b7..ML+0x35bf idiv
            c = P2_cell(0x1a0, fr, 0);         // ML+0x35cb cellAt / ML+0x35d8
            P2_enq(F, 0x28, 0x28, c, 0x1d);    // ML+0x35e9 enqueueSprite
        }
        break;
    }
