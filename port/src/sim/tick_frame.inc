// c3fy part P5: mainLoop ML+0x0, range ML+0x8032..ML+0x9607 (1,707 instructions, 86 call sites), hand-written
// from log/c3/alt/c3fy_norm.asm. Every [F+X] access of the original stays a frame access at the same offset and width.
// Entry: no register is live at ML+0x8032. Exit: falls through to ML+0x9607 with no register live.
// Phases: ML+0x8032..ML+0x8ff3 the simulation tick (P5_sim), ML+0x8ffb..ML+0x9545 the SimFoto frame and its
// snapshot (P5_simfoto), ML+0x9545..ML+0x9607 the zoomed copy and the marker pass (P5_zoom).

// ====================================================================================================================
// ML+0x80a2..ML+0x8258: the random tile event. Picks a random tile (row Rnd(50), column Rnd(50)) whose flag word has
// neither 0x400 nor 0x800, looks at its four neighbours (table offsets 0, 8, 0x10, 0x18 of f_tab_dirDx_4c2878 / f_tab_dirDy_4c2898),
// and when every free neighbour pattern passes, marks the tile (flag bits 0x4800, byte tile_anim_frame + tile = 1) and plays
// sound 0x22 there.
// ====================================================================================================================
void P5_tileEvent(u32 F) {
    const int edi = Rnd(0x32) & 0xffff;                    // ML+0x80a9, mov di, ax / and edi, 0xffff (ML+0x80b8)
    const int ebx = Rnd(0x32) & 0xffff;                    // ML+0x80be, mov bx, ax / and ebx, 0xffff (ML+0x80c9)
    const int idx = ebx + edi * 50;                        // ML+0x80c6..ML+0x80d2
    FD(0x28) = idx;                                        // ML+0x80d5
    if ((GU16(GS(g_tileFlags) + idx * 2) & 0xc00) != 0) return; // ML+0x80d9..ML+0x80e9 -> ML+0x8258
    FD(0x10) = 0;                                          // ML+0x80f1
    FD(0xc) = 0;                                           // ML+0x80f5
    FD(0x18) = 0;                                          // ML+0x80f9
    int off;
    do {
        off = FD(0x18);                                    // ML+0x80fd
        const int ebp = G32(GS(f_tab_dirDy_4c2898) + off) + ebx;       // ML+0x8101 / ML+0x810d
        const int esi = G32(GS(f_tab_dirDx_4c2878) + off) + edi;       // ML+0x8107 / ML+0x810f
        if (cc("tileBlocked", esi, ebp) == 0) {               // ML+0x8113 tileBlocked(esi, ebp); ML+0x811d
            const int n = ebp + esi * 50;                  // ML+0x811f..ML+0x8125
            if ((GU16(GS(g_tileFlags) + n * 2) & 0x800) != 0) { // ML+0x8129..ML+0x813a
                const int edx = FD(0x10);                  // ML+0x813c
                const int ecx = FD(0xc);                   // ML+0x8140
                FD(0x10) = edx | 1;                        // ML+0x8144 / ML+0x8148
                FD(0xc) = ecx + 1;                         // ML+0x8147 / ML+0x814c
            }
            const int t = G8(GS(g_tileType) + n);              // ML+0x8150 movsx
            if (G8((GS(g_tileTypeAttrs) + 34) + t * 48) <= 0)              // ML+0x8157..ML+0x8165 (signed byte, jg skips)
                FD(0x10) = FD(0x10) | 2;                   // ML+0x8167..ML+0x816d
        }
        off = FD(0x18) + 8;                                // ML+0x8171 / ML+0x8175
        FD(0x18) = off;                                    // ML+0x817b
    } while (off < 0x20);                                  // ML+0x8178 / ML+0x817f
    if (FD(0x10) != 3 || FD(0xc) > 3) FD(0x10) = 0;        // ML+0x8185..ML+0x8198 (eax = 3 at ML+0x8189)
    if ((GU16(GS(g_tileFlags) + FD(0x28) * 2) & 0x1000) != 0) { // ML+0x81a0..ML+0x81b5
        const int r = Rnd(3) & 0xffff;                     // ML+0x81bd (push eax, eax = 3 from ML+0x8189); ML+0x81c6
        FD(0x10) = (r <= FD(0xc)) ? 1 : 0;                 // ML+0x81c2..ML+0x81d2 setle (signed)
    }
    if (FD(0x10) == 0) return;                             // ML+0x81d6..ML+0x81dc -> ML+0x8258
    const int g = FD(0x14) << 8;                           // ML+0x81de / ML+0x81e4
    if (cc("holeQuadrants", G32((GS(g_golfers) + 212) + g), G32((GS(g_golfers) + 216) + g), 2) != 0) return;   // ML+0x81f5 holeQuadrants; ML+0x81ff
    const int t2 = FD(0x28);                               // ML+0x8201
    const s8 cl = G8(GS(g_tileType) + t2);                     // ML+0x8205
    if (cl != 2) {                                         // ML+0x8208 / ML+0x820e
        const u8 a = GU8((GS(g_tileTypeAttrs) + 38) + cl * 48);            // ML+0x8210..ML+0x8219 (movsx index)
        if (a != 4 && a != 0xd) return;                    // ML+0x821f..ML+0x8227 -> ML+0x8258
    }
    GU8((GS(g_tileFlags) + 1) + t2 * 2) |= 0x48;                      // ML+0x8229
    GU8(GS(tile_anim_frame) + t2) = 1;                              // ML+0x8249
    cc("playSoundAt", 0x22, (edi << 10) + 0x200, (ebx << 10) + 0x200, 0);   // ML+0x8250 playSoundAt
}

// ====================================================================================================================
// ML+0x8258..ML+0x867e: every 0x400 / ([g_difficulty] + 2) date ticks. Charges every open hole record one unit
// (dword +0x1f8 of each 0x208 record at g_holes counts up, cash g_cash_div100 and the year word g_financeYears+0xc + 20 *
// (year % 100) count down), lets walkers with a negative mode pay their table price (pointsPopup at the nearest hole),
// records this month's skill / fun / cash / member-count words in the four 500-entry word logs, and visits one slice of
// the 256 placed objects (stride [g_difficulty] + 2) re-rating every lot (object type 5), where a new home buyer is drawn.
// Returns edi as the original holds it at ML+0x8684 (the date [g_date]).
// ====================================================================================================================
int P5_dateTick(u32 F) {
    const int edx = G32(GS(g_difficulty));                       // ML+0x8258
    int edi = G32(GS(g_date));                             // ML+0x8263
    const int ebp = edx + 2;                               // ML+0x8269
    const int ecx = 0x400 / ebp;                           // ML+0x825e..ML+0x826d
    FD(0x2c) = ebp;                                        // ML+0x826f
    FD(0x18) = ecx;                                        // ML+0x827a
    if (edi % ecx != 0) return edi;                        // ML+0x8275..ML+0x8280 -> ML+0x8684

    // ML+0x8286..ML+0x82d0: the 19 hole records g_holes + 0x208 k (k = 0..18), ecx = record + 0x1f8
    const short si = G16(GS(g_year));                      // ML+0x8286
    for (u32 p = (GS(g_holes) + 504); p < (GS(g_holes) + 10384); p += 0x208) { // ML+0x828d, ML+0x82c4..ML+0x82d0
        if (GU8(p - 0x1f8) != 0) {                         // ML+0x8292..ML+0x829a
            const int bx = G32(GS(g_cash_div100)) - 1;            // ML+0x829c / ML+0x82a7
            G32(p) = G32(p) + 1;                           // ML+0x82a2 / ML+0x82a8 / ML+0x82a9
            const int y = (int)si % 100;                   // ML+0x82a4..ML+0x82b1
            G32(GS(g_cash_div100)) = bx;                          // ML+0x82b3
            G16((GS(g_financeYears) + 12) + y * 20) -= 1;                 // ML+0x82b9 / ML+0x82bc
        }
    }

    // ML+0x82d2..ML+0x83ad: the 64 walker records of 0x4c bytes at g_walkers (esi = record + 0x13)
    for (u32 esi = (GS(g_walkers) + 19); esi < (GS(g_editQueueX) + 19); esi += 0x4c) {   // ML+0x82d2, ML+0x83a4..ML+0x83ad
        if (GU8(esi - 1) == 0) continue;                   // ML+0x82dc..ML+0x82e1
        const s8 m = G8(esi);                              // ML+0x82e7
        if (m >= 0) continue;                              // ML+0x82e9 / ML+0x82eb (signed)
        if (m == (s8)0xfa) continue;                       // ML+0x82f1 / ML+0x82f3
        const int n = 4 - G32(GS(g_difficulty));                 // ML+0x82f9..ML+0x8303
        const int b = cc("bucketValue", G32(GS(g_holesPlusOne)) - 1); // ML+0x8305..ML+0x830c bucketValue
        FD(0x34) = b;                                      // ML+0x831b
        const int r = Rnd(n) & 0xffff;                     // ML+0x8320 / ML+0x8329
        if (r > FD(0x34)) continue;                        // ML+0x8325..ML+0x8330 (signed)
        if ((G32(GS(g_flags)) & 0x4000000) != 0) continue;  // ML+0x8332 / ML+0x8338 (ebx = 4000000 from ML+0x82d7)
        const int k = (GU8(esi - 1) & 8) ? 3 : 4;          // ML+0x833a..ML+0x834e: and dl, 8 / neg / sbb / add 4
        const int j = -(int)G8(esi) * 2 - k;               // ML+0x8342, ML+0x834c, ML+0x8351, ML+0x8353
        const int pts = G8(GS(f_tab_bytes_4c2e2c) + j);                // ML+0x8355 movsx
        G32(GS(g_cash_div100)) -= pts;                            // ML+0x835c
        const int y = (int)G16(GS(g_year)) % 100;          // ML+0x8362..ML+0x836a (ecx = 0x64 at ML+0x833d)
        const int wy = G32(esi - 0xf) << 10;               // ML+0x836f / ML+0x8372
        G16((GS(g_financeYears) + 10) + y * 20) -= (short)pts;            // ML+0x836c / ML+0x8375
        const int wx = G32(esi - 0x13) << 10;              // ML+0x837d / ML+0x8380
        const int h = cc("nearestHole", wx, wy);              // ML+0x8385 nearestHole
        cc("pointsPopup", -pts, G32(esi - 0x13), G32(esi - 0xf), h);   // ML+0x8398 pointsPopup
        G16(esi + 0x11) += (short)pts;                     // ML+0x83a0
    }

    // ML+0x83b3..ML+0x8442: this month's slot in the word logs
    edi = G32(GS(g_date));                                 // ML+0x83b3
    const int slot = (edi / 1024) % 500;                   // ML+0x83be..ML+0x83cd
    const short sk = G16(GS(g_skillRatingX100));                      // ML+0x83cf
    const short cash = G16(GS(g_cash_div100));                    // ML+0x83d5 (low word of the cash dword)
    G16(GS(g_skillHistory) + slot * 2) = sk;                       // ML+0x83e0
    G16(GS(g_funHistory) + slot * 2) = G16(GS(g_funRating));          // ML+0x83e7 / ML+0x83ed
    G16(GS(g_cashHistory) + slot * 2) = cash;                     // ML+0x83f4
    int cnt = 0;                                           // ML+0x83de
    G32(GS(g_eoy58b388)) = cnt;                                 // ML+0x83fb
    for (u32 p = (GS(g_golferTypeState) + 2); p < (GS(g_golferTypeState) + 3346); p += 0x2c) {  // ML+0x8401, ML+0x8417..ML+0x841f (76 type records)
        if (GU8(p + 0x27) != 0xff && (GU8(p) & 7) > 1) cnt++;   // ML+0x8406..ML+0x8416
    }
    G16(GS(g_memberTypeHistory) + slot * 2) = (short)cnt;               // ML+0x8423
    const int q = edi / FD(0x18);                          // ML+0x8421..ML+0x842b
    G32(GS(g_eoy58b388)) = cnt;                                 // ML+0x842f
    const int rem = q % ebp;                               // ML+0x8435 / ML+0x8436
    FD(0x18) = rem;                                        // ML+0x843e
    if (rem >= 0x100) return edi;                          // ML+0x8438 / ML+0x8442 -> ML+0x8684

    // ML+0x8448..ML+0x8678: placed objects rem, rem + stride, ... (records of 16 bytes at g_placed_objects, ebx = +0xc)
    const int stride = FD(0x2c) << 4;                      // ML+0x8448 / ML+0x844e
    u32 ebx = (u32)(rem << 4) + (GS(g_placed_objects) + 12);                // ML+0x844c / ML+0x8451 / ML+0x8458
    FD(0xc) = stride;                                      // ML+0x8454
    int v;
    do {
        if (G16(ebx - 0xc) == 5) {                         // ML+0x845e / ML+0x8463
            const int y2 = G16(ebx - 8);                   // ML+0x8469 movsx
            const int x2 = G16(ebx - 0xa);                 // ML+0x846d movsx
            int esi = G32(ebx);                            // ML+0x8471
            const int rate = cc("rateLot", x2, y2);       // ML+0x8475 rateLot
            const u8 fl = GU8(GS(g_forcedEventBits));                 // ML+0x848f
            esi -= esi / 12;                               // ML+0x847c..ML+0x8494 (2aaaaaab, sar 1)
            G32(ebx) = rate + esi;                         // ML+0x8496 / ML+0x849a
            if (fl & 0x80) {                               // ML+0x8498 / ML+0x849c
                const u32 w = GU32(GS(g_forcedEventBits));            // ML+0x849e
                G32(ebx) = 0x9c4;                          // ML+0x84a3
                GU32(GS(g_forcedEventBits)) = w & 0xffffff7f;         // ML+0x84a9 and al, 0x7f / ML+0x84ab
            }
            int who;
            do {
                who = Rnd(0x64) & 0xffff;                  // ML+0x84b7, mov bp, ax / and ebp, 0xffff
            } while (GU8((GS(g_celebrities) + 32) + who * 37) == 0xff);  // ML+0x84c5..ML+0x84d1
            if (G32(ebx - 4) == 0) {                       // ML+0x84d3..ML+0x84d8
                const int nb = G32((GS(f_w_4c2848) + 4));            // ML+0x84de
                const int lim = (nb * 300 + 0x190) * (G32(GS(g_difficulty)) + 2);   // ML+0x84e3..ML+0x84fc
                if (G32(ebx) > lim) {                      // ML+0x84ff / ML+0x8501 (signed)
                    const int rec = who * 37;              // ML+0x8507 / ML+0x8513
                    FD(0x34) = rec;                        // ML+0x8517
                    const int kind = G8((GS(g_celebrities) + 32) + rec); // ML+0x851b movsx
                    StrCpy(kBuf, GS(f_strpool_4c64a8));              // ML+0x8524..ML+0x853f
                    StrCat(kBuf, GU32(GS(f_ptrtab_4c2ba8) + kind * 4));    // ML+0x8541..ML+0x856c
                    StrCat(kBuf, GS(f_strpool_4c3f70));              // ML+0x856e..ML+0x859b
                    StrCat(kBuf, (u32)(FD(0x34) + GS(g_celebrities)));   // ML+0x8594..ML+0x85c9
                    StrCat(kBuf, GS(f_strpool_4c6444));              // ML+0x85cb..ML+0x85f7
                    if (cc("startMessage", (int)0x80004010, 0, -3) != 0) {   // ML+0x85fe startMessage (eax = 0 pushed at ML+0x85f6); ML+0x8608
                        G32(ebx - 4) = who + 1;            // ML+0x860a / ML+0x8613
                        cc("logTick", 0xc0, who);         // ML+0x8616 logTick
                        cc("playSound", 0x33, 0x64, 0, 0, 0);   // ML+0x8625 playSound
                        G32((GS(f_w_4c2848) + 4)) = G32((GS(f_w_4c2848) + 4)) + 1;  // ML+0x862a / ML+0x8633 / ML+0x863b
                        const int r6 = Rnd(6) & 0xffff;    // ML+0x8641 / ML+0x864f
                        cc("spawnObject", r6, who, (int)G16(ebx - 0xa), (int)G16(ebx - 8));   // ML+0x8657 spawnObject
                    }
                }
            }
        }
        v = FD(0x18) + FD(0x2c);                           // ML+0x865f..ML+0x866b
        ebx += FD(0xc);                                    // ML+0x8667 / ML+0x866d
        FD(0x18) = v;                                      // ML+0x8674
    } while (v < 0x100);                                   // ML+0x866f / ML+0x8678
    return G32(GS(g_date));                                // ML+0x867e
}

// ====================================================================================================================
// ML+0x8684..ML+0x8d2e: the 1024-tick (monthly) work. Autosave 1 at date % 1024 == 0x200; at date % 1024 == 0:
// autosave 2, the word logs again, the path warning for unconnected placed objects, the 1/8 decay of the hole
// statistics, interest on a negative cash balance, the empty-course hint, the SGA tournament offer (date % 8192 ==
// 0x1000) and the year end (date % 8192 == 0: the 1/8 decay of three 50x50 byte grids, a random column of the 9x6
// dword table, showEndOfYearScreen). edi = the date as held at ML+0x8684.
// ====================================================================================================================
void P5_tournament(u32 F) {
    // ML+0x8a05..ML+0x8c66: the Image at F+0x36c lives between the two state-byte stores
    tc("Image_ctor", FA(0x36c));                             // ML+0x8a0c Image_ctor
    FUB(0x124c) = 3;                                       // ML+0x8a2a
    tc("Surface_createFull", FA(0x36c), 0x320, 0x258, 0, 1, 0, 0);   // ML+0x8a32 Surface_createFull
    tc("Surface_blitThunk", Root(), FA(0x36c), 0, 0, 0, 0, 0x320, 0x258);   // ML+0x8a57 Surface_blitThunk (this = [f_stateptr_4c1570])
    cc("showCourseReport", 2);                                     // ML+0x8a5e showCourseReport(2)
    if (G32(GS(g_tournamentPurse)) != 0) {                            // ML+0x8a63..ML+0x8a6d
        tc("Surface_blitThunk", FA(0x36c), Root(), 0, 0, 0, 0, 0x320, 0x258);   // ML+0x8a73..ML+0x8a93 Surface_blitThunk
        StrCpy(kBuf, GS(f_strpool_4c62cc));                          // ML+0x8a98..ML+0x8ac7
        StrCat(kBuf, (u32)(GS(g_courseTable) + G32(GS(g_courseIndex)) * 46));   // ML+0x8abf, ML+0x8ac9..ML+0x8afe
        StrCat(kBuf, GS(f_strpool_4c627c));                          // ML+0x8b00..ML+0x8b2f
        StrCat(kBuf, (u32)Itoa(G32(GS(g_tournamentPurse)), GS(g_textBuf), 10));   // ML+0x8b24, ML+0x8b31 __itoa (pushes ML+0x8aa2 / ML+0x8aaa); ML+0x8b36..ML+0x8b62
        StrCat(kBuf, (GS(f_strpool_4c61e8) + 104));                          // ML+0x8b64..ML+0x8b97
        GU8(GS(g_ui_569498)) = 0;                               // ML+0x8b8f (al = 0 from ML+0x8b3b), inside the copy above
        StrCat(kBuf, (GS(g_golferTypes) + 16));                          // ML+0x8b99..ML+0x8bc2
        StrCat(kBuf, (GS(f_strpool_4c61e8) + 72));                          // ML+0x8bc4..ML+0x8bed
        cc("startMessage", (int)0x80001204, 1, -0x14);         // ML+0x8bef startMessage (pushes ML+0x8b5b / ML+0x8b60 / ML+0x8b72)
        cc("playSound", 0x2f, 0x64, 0, 0, 0);               // ML+0x8bfe playSound; ML+0x8c08 pops both calls and __itoa
        const u32 fl = GU32(GS(g_flags)) | (1u << 22);        // ML+0x8c03 / ML+0x8c0b
        G32(GS(g_tournamentPurse)) = 0;                               // ML+0x8c10
        GU32(GS(g_flags)) = fl;                             // ML+0x8c1a
    } else {                                               // ML+0x8c1f jmp skips this arm
        const u32 fl = GU32(GS(g_flags));                   // ML+0x8c21
        const int root = Root();                           // ML+0x8c27
        GU32(GS(g_flags)) = fl & 0xffbfffff;                // ML+0x8c3c / ML+0x8c4c
        tc("Surface_blitThunk", FA(0x36c), root, 0, 0, 0, 0, 0x320, 0x258);   // ML+0x8c52 Surface_blitThunk
    }
    FUB(0x124c) = 0;                                       // ML+0x8c5e
    tc("Image_dtor", FA(0x36c));                             // ML+0x8c66 Image_dtor
}

void P5_monthly(u32 F, int edi) {
    if (edi % 1024 == 0x200) cc("saveGame", (GS(f_strpool_4c63c8) + 112));  // ML+0x8684..ML+0x869a; ML+0x86a1 saveGame
    if (G32(GS(g_date)) % 1024 != 0) return;              // ML+0x86a9..ML+0x86bc -> ML+0x8d33
    cc("saveGame", (GS(f_strpool_4c63c8) + 100));                            // ML+0x86c7 saveGame

    // ML+0x86cc..ML+0x8715: the word logs again (store order of the original)
    const int slot = (G32(GS(g_date)) / 1024) % 500;      // ML+0x86cc..ML+0x86eb
    const short sk = G16(GS(g_skillRatingX100));                      // ML+0x86ed
    const short cash = G16(GS(g_cash_div100));                    // ML+0x86f3
    G16(GS(g_skillHistory) + slot * 2) = sk;                       // ML+0x8701
    const short fun = G16(GS(g_funRating));                     // ML+0x8708
    G16(GS(g_cashHistory) + slot * 2) = cash;                     // ML+0x870e
    G16(GS(g_funHistory) + slot * 2) = fun;                      // ML+0x8715

    // ML+0x871c..ML+0x882a: placed objects 1..255 of type 6..0xe without flag 0x40 in byte +7 (ebp = 4000000 from ML+0x86fa)
    for (u32 p = (GS(g_placed_objects) + 16); p < GS(g_sprites58ccb8); p += 0x10) {  // ML+0x86e2, ML+0x8821..ML+0x882a
        const short t = G16(p);                            // ML+0x871c
        if (t < 6) continue;                               // ML+0x871f / ML+0x8723 (signed)
        // ML+0x8729 `cmp dx, 5; je` can never be taken once t >= 6
        if (GU8(p + 7) & 0x40) continue;                   // ML+0x8733 / ML+0x8737
        if (t >= 0xf) continue;                            // ML+0x873d / ML+0x8741 (signed)
        if (G32(GS(g_difficulty)) == 0) continue;                // ML+0x8747..ML+0x874e
        if ((G32(GS(g_flags)) & 0x4000000) != 0) continue;  // ML+0x8754 / ML+0x875a
        StrCpy(kBuf, (GS(f_strpool_4c63c8) + 84));                          // ML+0x8760..ML+0x878f
        StrCat(kBuf, (u32)(GS(f_tab_buildItems_4c26b0) + (int)t * 20));     // ML+0x8789..ML+0x87c1
        StrCat(kBuf, (GS(f_strpool_4c63c8) + 20));                          // ML+0x87c3..ML+0x87ec
        StrCat(kBuf, GS(f_strpool_4c63c8));                          // ML+0x87ee..ML+0x8817
        cc("startMessage", (int)0x80006000, 1, -1);            // ML+0x8819 startMessage (pushes ML+0x876a / ML+0x8772 / ML+0x8780)
    }

    // ML+0x8830..ML+0x8906: hole records 1..18 (g_holes+0x208 + 0x208 k, c = record + 0x24) lose 1/8 of each statistic
    for (u32 c = (GS(g_holes) + 556); c < (GS(g_holes) + 9916); c += 0x208) { // ML+0x8830, ML+0x88fa..ML+0x8906
        int d = G32(c - 4);                                // ML+0x8835
        G32(c - 4) = d - d / 8;                            // ML+0x883e..ML+0x8850
        d = G32(c);                                        // ML+0x8853
        G32(c) = d - d / 8;                                // ML+0x8855..ML+0x8862
        short s = G16(c + 0x134);                          // ML+0x8864
        G16(c + 0x134) = (short)(s - s / 8);               // ML+0x886b..ML+0x8879
        d = G32(c + 0x1c8);                                // ML+0x8880
        G32(c + 0x1c8) = d - d / 8;                        // ML+0x8886..ML+0x8893
        s = G16(c + 0x136);                                // ML+0x8899
        G16(c + 0x136) = (short)(s - s / 8);               // ML+0x88a0..ML+0x88ae
        u32 w = c + 0xb4;                                  // ML+0x8838
        for (int k = 0x40; k != 0; k--) {                  // ML+0x8840, ML+0x88c9 / ML+0x88ce
            s = G16(w);                                    // ML+0x88b5
            w += 2;                                        // ML+0x88b8
            G16(w - 2) = (short)(s - s / 8);               // ML+0x88bb..ML+0x88ca
        }
        u32 w2 = c + 0x138;                                // ML+0x88d2
        for (int k = 0; k < 8; k++, w2 += 2) {             // ML+0x88d0, ML+0x88f1..ML+0x88f8
            if (k == 5) continue;                          // ML+0x88d8 / ML+0x88db
            s = G16(w2);                                   // ML+0x88dd
            G16(w2) = (short)(s - s / 8);                  // ML+0x88e0..ML+0x88ee
        }
    }

    // ML+0x890c..ML+0x8943: a negative cash balance grows by 1/50 (also added to the year word)
    const int bal = G32(GS(g_cash_div100));                       // ML+0x890c
    if (bal < 0) {                                         // ML+0x8912 / ML+0x8914
        const int y = (int)G16(GS(g_year)) % 100;          // ML+0x8916..ML+0x8923
        const int q = bal / 50;                            // ML+0x8925..ML+0x8937 (51eb851f, sar 4)
        G16((GS(g_financeYears) + 12) + y * 20) += (short)q;              // ML+0x892a / ML+0x8939
        G32(GS(g_cash_div100)) = bal + q;                         // ML+0x8941 / ML+0x8943
    }

    // ML+0x8949..ML+0x89c7: the build hint while mode [g_difficulty] is 0 and hole 1's dwords +0x8 or +0x18 are 0
    if (G32(GS(g_difficulty)) == 0 && (G32((GS(g_holes) + 528)) == 0 || G32((GS(g_holes) + 544)) == 0)) {   // ML+0x8950, ML+0x8959, ML+0x8962
        StrCpy(kBuf, GS(f_strpool_4c6378));                          // ML+0x8964..ML+0x8995
        G32(GS(g_panelListMode)) = 0;                               // ML+0x898d (eax = 0 from ML+0x896c), inside the copy above
        StrCat(kBuf, GS(f_strpool_4c6328));                          // ML+0x8997..ML+0x89c0
        cc("startMessage", (int)0x80006000, 1, -1);            // ML+0x89c2 startMessage (pushes ML+0x896e / ML+0x8976 / ML+0x8981)
    }

    // ML+0x89ca..ML+0x8c66: the SGA tournament offer
    if (G32(GS(g_date)) % 8192 == 0x1000 && G32(GS(g_playerGolfer)) == -1 && (G32(GS(g_flags)) & 0x1200000) == 0)   // ML+0x89ca..ML+0x89ff
        P5_tournament(F);

    // ML+0x8c6b..ML+0x8d2e: the year end
    if (G32(GS(g_date)) % 8192 != 0) return;              // ML+0x8c6b..ML+0x8c81 -> ML+0x8d33
    for (u32 row = GS(g_tileMoodUp); row < GS(g_year); row += 0x32) {   // ML+0x8c87, ML+0x8cdb..ML+0x8ce4
        const int off = (int)(row - GS(g_tileMoodUp));           // ML+0x8c8c / ML+0x8c90
        for (int i = 0; i < 0x32; i++) {                   // ML+0x8c8e, ML+0x8cd5..ML+0x8cd9
            u8 b = GU8(GS(g_tileMoodUp) + i + off);              // ML+0x8c96
            GU8(GS(g_tileMoodUp) + i + off) = (u8)(b - (b >> 3)); // ML+0x8c9d..ML+0x8ca4
            b = GU8(GS(g_tileMoodDown) + i + off);                 // ML+0x8cab
            GU8(GS(g_tileMoodDown) + i + off) = (u8)(b - (b >> 3)); // ML+0x8cb2..ML+0x8cb9
            b = GU8(GS(g_ballStopCount) + i + off);                 // ML+0x8cc0
            GU8(GS(g_ballStopCount) + i + off) = (u8)(b - (b >> 3)); // ML+0x8cc7..ML+0x8cce
        }
    }
    int e = 0;                                             // ML+0x8ce6
    u32 s = (GS(g_courseRanking) + 20);                                    // ML+0x8ce8
    do {
        const int r = Rnd(4) & 0xffff;                     // ML+0x8cf4 / ML+0x8cf9
        s += 0x18;                                         // ML+0x8cfe
        const int i = r + e;                               // ML+0x8d01
        e += 6;                                            // ML+0x8d03
        G32(GS(g_courseRanking) + i * 4) = G32(GS(g_courseRanking) + i * 4) + 1;   // ML+0x8d06..ML+0x8d15
        G32(s - 0x18) = G32(s - 0x18) + 1;                 // ML+0x8d17 / ML+0x8d1a / ML+0x8d21
    } while (s < (GS(g_courseRanking) + 236));                              // ML+0x8d1b / ML+0x8d24
    if ((G32(GS(g_flags)) & 0x4000000) == 0)                // ML+0x8d26 / ML+0x8d2c (ebp = 4000000 from ML+0x86fa)
        cc("showEndOfYearScreen");                                    // ML+0x8d2e showEndOfYearScreen (no argument pushed)
}

// ====================================================================================================================
// ML+0x8d33..ML+0x8ff8: one frame in 100 plays one of seven ambient sounds (switch table ML+0x121bc) at a random
// volume / pan / pitch.
// ====================================================================================================================
void P5_ambient() {
    if ((Rnd(0x64) & 0xffff) != 0) return;                 // ML+0x8d3a, ML+0x8d3f test ax, ax / ML+0x8d42 -> ML+0x8ffb
    const u32 r = (u32)(Rnd(6) & 0xffff);                  // ML+0x8d4f / ML+0x8d54
    if (r > 6) return;                                     // ML+0x8d59 / ML+0x8d5c ja -> ML+0x8ffb
    int id = 0;
    switch (r) {                                           // ML+0x8d62 jmp [eax*4 + ML+0x121bc]
