        int ecx;
        int eax = cc("tileBlocked", FD(0x1c), FD(0x24)); // ML+0xf791 tileBlocked
        ecx = FD(0x1c);                               // ML+0xf796
        if (eax == 0) {                               // ML+0xf79f
            u32 i = H2_cell(ecx, FD(0x24));
