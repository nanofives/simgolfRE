    if (GU8((GS(g_walkers) + 18)) == 0) return;                                         // ML+0x6d62 / ML+0x6d69
    if (GU8((GS(g_walkers) + 19)) != 0xfa) return;                                      // ML+0x6d6f / ML+0x6d76
