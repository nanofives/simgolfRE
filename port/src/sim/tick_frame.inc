        u8 bl = GU8(GS(g_date));                                              // ML+0x6e4d
        if ((bl & 0x20) == 0) {                                               // ML+0x6e53 / ML+0x6e56
            StrCpy(kBuf, (GS(f_strpool_4c64a8) + 940));                                         // ML+0x6e58..ML+0x6e7d
            if (e != 0 && bp != 0)                                            // ML+0x6e7b / ML+0x6e7f / ML+0x6e81 / ML+0x6e83
                StrCpy(kBuf, (GS(f_strpool_4c64a8) + 896));                                     // ML+0x6e85..ML+0x6ea5, shared tail ML+0x6ed0..ML+0x6ed3
        } else {
