        }
        eax = cc("tileBlocked", ecx, FD(0x24));          // ML+0xf7f8 tileBlocked
        if (eax == 0) {                               // ML+0xf802
            u32 i = H2_cell(FD(0x1c), FD(0x24));
            if (H2_TT(i) == 0) {                      // ML+0xf819 / ML+0xf821
                int h = H2_TWL(i) & 0x1f;             // ML+0xf827 / ML+0xf82e
                ebp = h;                              // ML+0xf831
                if (GU8((GS(g_holes) + 512) + (u32)h * 0x208u) & 3) {   // ML+0xf83a / ML+0xf842
                    // rename hole: text = f_strpool_4c5c10 + itoa(h) + f_strpool_4c5c0c, copied to F+0x308 as the prompt
                    GU8(kBuf) = 0;                                    // ML+0xf852
                    StrCpy(kBuf, GS(f_strpool_4c5c10));                         // ML+0xf859..ML+0xf87a
                    u32 s = (u32)Itoa(ebp, GS(g_textBuf), 10);           // ML+0xf87c
                    StrCat(kBuf, s);                                  // ML+0xf883..ML+0xf8aa
                    StrCat(kBuf, GS(f_strpool_4c5c0c));                         // ML+0xf8ac..ML+0xf8dc
                    StrCpy((u32)FA(0x308), kBuf);                     // ML+0xf8de..ML+0xf8fc
                    GU8(kBuf) = 0;                                    // ML+0xf8fe
                    cc("appendHoleName", ebp);                              // ML+0xf905 appendHoleName(h) (push at ML+0xf888)
                    cc("textInputBox", FA(0x308), 0xc8, 0x20, 0x20);      // ML+0xf91b textInputBox
                    if (GU8(kBuf) == 0) return kFrame;                // ML+0xf920 / ML+0xf92a
                    cc("appendToBuffer45b8b0", ebp);                              // ML+0xf931 appendToBuffer45b8b0(h)
                    return kFrame;                                    // ML+0xf939
                }
            }
        }
    }
    // ML+0xf93e
    if (G32(GS(g_panelListMode)) == 5) {
        int mx = G32((GS(g_rootInput) + 8));                     // ML+0xf947
        if (mx >= 0xcc && G32((GS(g_rootInput) + 12)) > 0x23f) {  // ML+0xf951 / ML+0xf95d
            int g = G32(GS(g_golferStripSlot) + 4u * (u32)((mx - 0xcc) / 16));   // ML+0xf95f..ML+0xf96d
            if (g < -1) return kFrame;                // ML+0xf977
            if (g >= 0x98) return kFrame;             // ML+0xf982
            G32(GS(g_msgState53df54)) = g + 1;                  // ML+0xf98e
            u32 r = (u32)g << 8;                      // ML+0xf98b
            G32(GS(gCameraTileX)) = G32(GS(g_golfers) + r) >> 10;   // ML+0xf994 / ML+0xf9a6
