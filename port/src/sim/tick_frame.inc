    eax = eax / 2;                                                            // ML+0x66b2 / ML+0x66b3 / ML+0x66c5 (cdq, sub, sar 1)
    int y = ((int)G16(ecx + 4) << 10) + eax + 0x200;                          // ML+0x66bd / ML+0x66c7 / ML+0x66cd
    int x = ((int)G16(ecx + 2) << 10) + eax + 0x200;                          // ML+0x66c1 / ML+0x66ca / ML+0x66d5
    if (cc("worldToScreen", x, y, FA(0x148), FA(0x124), 0) == 0) return;           // worldToScreen ML+0x66dd, ML+0x66e7
    int n = 0;
    if (ebp == 5 && (n = G32(FU(0xc) + 8)) > 0) {                             // ML+0x66f0 / ML+0x66f6..ML+0x66ff
        StrCpy(kBuf, (u32)(n * 37 + (GS(g_golferPhrases) + 104963)));                             // ML+0x6705..ML+0x672d
        StrCat(kBuf, GS(f_strpool_4c68dc));                                             // ML+0x672f..ML+0x6760
        if (G32(GS(g_zoomScale)) != 4) return;                                     // ML+0x6753 / ML+0x6762
        if (((FD(0x28) + G32(GS(g_date))) & 0x30) != 0) return;               // ML+0x6768..ML+0x6776
        cc("drawCenteredText2", (int)kBuf, FD(0x148), FD(0x124) - 0xc, (int)0x80007E9F);   // drawCenteredText2 ML+0x6799
        int z = G32(GS(g_zoomScale));                                              // ML+0x679e
        int d = 4 - z;                                                        // ML+0x67ab / ML+0x67b5
        cc("drawCenteredText2", (GS(f_strpool_4c64a8) + 1068), FD(0x148), FD(0x124) + d * 2 + d, (int)0x80007E9F);   // drawCenteredText2 ML+0x67ca
        return;                                                               // ML+0x67d2
    }
    // ML+0x67ea
    GU8(GS(g_textBuffer)) = 0;                                                      // ML+0x67ed
    if (ebp >= 6 && ebp != 7 && ebp != 5) {                                   // ML+0x67f4 / ML+0x67f9 / ML+0x67fe (ebp != 5 always true here)
        int e = G32((u32)ebp * 4 + GS(g_objectTypeLevel));                               // ML+0x6800
        if (e == 2) StrCpy(kBuf, (GS(f_strpool_4c6980) + 40));                                 // ML+0x680a, ML+0x680c..ML+0x682f
        if (e == 3) StrCpy(kBuf, (GS(f_strpool_4c6980) + 32));                                 // ML+0x6834, ML+0x6836..ML+0x6859
    }
    StrCat(kBuf, (u32)(ebx + GS(f_tab_buildItems_4c26b0)));                                    // ML+0x685b..ML+0x688a
    if (ebp < 6) return;                                                      // ML+0x6887 / ML+0x688c
    if ((GU8(FU(0xc) + 7) & 0x40) != 0) return;                               // ML+0x688e..ML+0x6896
    int dl = (FD(0x18) + G32(GS(g_date))) & 8;                                // ML+0x6898..ML+0x68ab
    int color = (int)((dl != 0 ? 0x1D08u : 0u) + 0x80006000u);                // ML+0x68b5..ML+0x68c2 (neg dl, sbb, and, add)
    cc("drawCenteredText2", (int)kBuf, FD(0x148), FD(0x124) - 0x10, color);            // drawCenteredText2 ML+0x68d0
}

void P4_objectLabels(u32 F) {
    for (;;) {
