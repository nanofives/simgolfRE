        esi = (H2_TT(i) != 0x11) ? 2 : 0xf;           // ML+0x113ed..ML+0x113fe (sub / neg / sbb / and / add)
        cc("setGrids", x, y, 0xa0, esi);              // ML+0x11408 setGrids
        eax = G32(GS(f_w_4c2848));                        // ML+0x1140d
    }
    if (eax == 0x280) {                               // ML+0x11415 / ML+0x1141a
        int x = FD(0x1c), y = FD(0x24);
        u32 i = H2_cell(x, y);
        u16 w = H2_TW(i);                             // ML+0x1142d
        if (w & 0x20) {                               // ML+0x11435 / ML+0x11438
            esi = 2;                                  // ML+0x1143a
            H2_TW(i) = w;                             // ML+0x1143f (same value written back)
            cc("setGrids", x, y, 0x280, esi);         // ML+0x1144f setGrids
            goto L_a2f;                               // ML+0x11457
        }
