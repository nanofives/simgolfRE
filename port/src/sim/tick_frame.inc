// and setGrids(x, y, 0x280, 2), without flag 0x20 the refusal sound. A non-zero c is charged to the cash, to the
// current hole's spend dword (g_holes+0x1f0 + hole * 0x208) and to the ledger word g_financeYears+0x6 of the current row.
int H2_TerrainSpecial(u32 F, int eax) {
    if (G32((GS(g_rootInput) + 16)) != 1) return H2_Rebuild(F);   // ML+0x113be / ML+0x113c5
