// ML+0x7888..ML+0x7cb7: the 64 walker records (0x4c bytes; ebx = record + 0x15 from g_walkers+0x15 to g_editQueueX+0x15,
// ebp = 0x23 * index). A walker with flags byte +0x12 (ebx - 3) and comment byte +0x15 in 1..7 on screen at zoom
// > 2 gets a text chosen by its kind byte +0x14 (ebx - 1) through the switch ML+0x12180 / ML+0x12160 (kind 35:
// by ((date + ebp) / 100) % 4 through ML+0x121ac), six bubble pieces of Surface g_sprite5787d0 and the text drawn
// above it; [F+0xa0] / [F+0x80] hold the projection, [F+0x80] steps by 8 after the text.
void P4_walkerOne(u32 F, u32 ebx, int ebp) {
    if (GU8(ebx - 3) == 0) return;                                            // ML+0x788f / ML+0x7894
    if (GU8(ebx) == 0) return;                                                // ML+0x789a / ML+0x789d
    if (cc("worldToScreen", G32(ebx - 0x15), G32(ebx - 0x11), FA(0xa0), FA(0x80), 0) == 0) return;   // worldToScreen ML+0x78bd, ML+0x78c7
    s8 al = G8(ebx);                                                          // ML+0x78cd
    if (al == 0) return;                                                      // ML+0x78d1
    if (al > 7) return;                                                       // ML+0x78d7 / ML+0x78d9 jg
    if (G32(GS(g_zoomScale)) <= 2) return;                                         // ML+0x78df / ML+0x78e6 jle
    int k = (int)G8(ebx - 1) + 7;                                             // ML+0x78ec / ML+0x78f0
    if ((u32)k <= 0x2a) {                                                     // ML+0x78f3 / ML+0x78f6 ja ML+0x7aa8
        switch (sw_p4_kind(k)) {                                  // ML+0x78fe index byte, ML+0x7904 jmp [ML+0x12160 + 4 i]
